#include <cmath>
#include "kernel_operator.h"
#include "tiling/platform/platform_ascendc.h"
/*
 * RotaryPosEmb Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 实现依据：.cannbot/rotaryposemb/2.2-开发方案设计.md（SIMD/MemBase，head-row 工作单元，
 * TQue 双缓冲三级流水，快/慢双路径，pair 算术 bit-exact inv_freq，Cody-Waite 预缩减 +
 * 2201 高阶 Sin/Cos，O1/O2 必落地）。
 */

namespace rotary_emb_impl {

// ============================================================================
// double-fp32 (pair) 算术原语 —— 开发方案 §2.2，probe A1/C2 上板 bit-exact 验证。
// ccec 禁 double/powf/位重解释，inv_freq 精度硬依赖本路径，禁止改动运算次序。
// ============================================================================
static constexpr float P_SPLITTER = 8193.0f;

__aicore__ inline void TwoSum(float a, float b, float& s, float& e)
{
    s = a + b;
    float a1 = s - b;
    float b1 = s - a1;
    e = (a - a1) + (b - b1);
}

__aicore__ inline void QuickTwoSum(float a, float b, float& s, float& e)  // |a|>=|b|
{
    s = a + b;
    e = b - (s - a);
}

__aicore__ inline void Split(float a, float& hi, float& lo)
{
    float t = a * P_SPLITTER;
    hi = t - (t - a);
    lo = a - hi;
}

__aicore__ inline void TwoProd(float a, float b, float& p, float& e)  // a*b = p+e exact
{
    p = a * b;
    float ah, al, bh, bl;
    Split(a, ah, al);
    Split(b, bh, bl);
    e = ((ah * bh - p) + ah * bl) + al * bh;
    e = e + al * bl;
}

__aicore__ inline void PairAdd(float xh, float xl, float yh, float yl, float& rh, float& rl)
{
    float sh, se;
    TwoSum(xh, yh, sh, se);
    float t = se + (xl + yl);
    QuickTwoSum(sh, t, rh, rl);
}

__aicore__ inline void PairMul(float xh, float xl, float yh, float yl, float& rh, float& rl)
{
    float p, e;
    TwoProd(xh, yh, p, e);
    float t = (xh * yl) + (xl * yh);
    float s = e + t;
    QuickTwoSum(p, s, rh, rl);
}

// pair 常量（离线生成，hex 字面量精确）
static constexpr float C_LN2_H  = 0x1.62e4300000000p-1f,  C_LN2_L  = -0x1.05c6100000000p-29f;
static constexpr float C_ILN2_H = 0x1.7154760000000p+0f,  C_ILN2_L =  0x1.4ae0c00000000p-26f;
static constexpr float C_E00_H = 0x1.0000000000000p+0f,  C_E00_L = 0x0.0p+0f;
static constexpr float C_E01_H = 0x1.0000000000000p+0f,  C_E01_L = 0x0.0p+0f;
static constexpr float C_E02_H = 0x1.0000000000000p-1f,  C_E02_L = 0x0.0p+0f;
static constexpr float C_E03_H = 0x1.5555560000000p-3f,  C_E03_L = -0x1.5555560000000p-28f;
static constexpr float C_E04_H = 0x1.5555560000000p-5f,  C_E04_L = -0x1.5555560000000p-30f;
static constexpr float C_E05_H = 0x1.1111120000000p-7f,  C_E05_L = -0x1.ddddde0000000p-32f;
static constexpr float C_E06_H = 0x1.6c16c20000000p-10f, C_E06_L = -0x1.27d27e0000000p-35f;
static constexpr float C_E07_H = 0x1.a01a020000000p-13f, C_E07_L = -0x1.7f97fa0000000p-39f;
static constexpr float C_E08_H = 0x1.a01a020000000p-16f, C_E08_L = -0x1.7f97fa0000000p-42f;
static constexpr float C_E09_H = 0x1.71de3a0000000p-19f, C_E09_L = 0x1.55b1cc0000000p-45f;
static constexpr float C_E10_H = 0x1.27e4fc0000000p-22f, C_E10_L = -0x1.10ec140000000p-47f;
static constexpr float C_E11_H = 0x1.ae64560000000p-26f, C_E11_L = 0x1.fd51380000000p-52f;
static constexpr float C_A00_H = 0x1.0000000000000p+0f,  C_A00_L = 0x0.0p+0f;
static constexpr float C_A01_H = 0x1.5555560000000p-2f,  C_A01_L = -0x1.5555560000000p-27f;
static constexpr float C_A02_H = 0x1.99999a0000000p-3f,  C_A02_L = -0x1.99999a0000000p-29f;
static constexpr float C_A03_H = 0x1.24924a0000000p-3f,  C_A03_L = -0x1.b6db6e0000000p-28f;
static constexpr float C_A04_H = 0x1.c71c720000000p-4f,  C_A04_L = -0x1.c71c720000000p-31f;
static constexpr float C_A05_H = 0x1.745d180000000p-4f,  C_A05_L = -0x1.745d180000000p-29f;
static constexpr float C_A06_H = 0x1.3b13b20000000p-4f,  C_A06_L = -0x1.89d89e0000000p-29f;
static constexpr float C_A07_H = 0x1.1111120000000p-4f,  C_A07_L = -0x1.ddddde0000000p-29f;
static constexpr float C_A08_H = 0x1.e1e1e20000000p-5f,  C_A08_L = -0x1.e1e1e20000000p-33f;
static constexpr float C_A09_H = 0x1.af286c0000000p-5f,  C_A09_L = -0x1.af286c0000000p-32f;

__aicore__ inline void RecipPair(float dh, float dl, float& rh, float& rl)  // 1/(dh+dl)
{
    float r0 = 1.0f / (dh + dl);
    rh = r0;
    rl = 0.0f;
    for (int it = 0; it < 2; it++) {
        float ph, pl;
        PairMul(dh, dl, rh, rl, ph, pl);
        float sh, sl;
        PairAdd(2.0f, 0.0f, -ph, -pl, sh, sl);
        PairMul(rh, rl, sh, sl, rh, rl);
    }
}

// L = log2(theta)，theta 为正 fp32；精确 ×2/÷2 缩放分解，无位重解释
__aicore__ inline void Log2Pair(float theta, float& lh, float& ll)
{
    int k = 0;
    float t = theta;
    while (t >= 2.0f) { t = t * 0.5f; k++; }
    while (t < 1.0f)   { t = t * 2.0f; k--; }
    float m = t;                    // m in [1,2)
    float u = m - 1.0f;             // exact
    if (u == 0.0f) { lh = (float)k; ll = 0.0f; return; }
    float dh = 2.0f + u;            // fl(2+u)
    float dl = u - (dh - 2.0f);     // Sterbenz 精确残差
    float rh, rl;
    RecipPair(dh, dl, rh, rl);
    float vh, vl;
    PairMul(u, 0.0f, rh, rl, vh, vl);   // v = u/(2+u)
    float wh, wl;
    PairMul(vh, vl, vh, vl, wh, wl);    // w = v^2
    // atanh 级数 Horner：acc = 1/19；j=8..0: acc = 1/(2j+1) + w*acc
    float ah = C_A09_H, al = C_A09_L;
    const float ch[9] = {C_A00_H, C_A01_H, C_A02_H, C_A03_H, C_A04_H, C_A05_H, C_A06_H, C_A07_H, C_A08_H};
    const float cl[9] = {C_A00_L, C_A01_L, C_A02_L, C_A03_L, C_A04_L, C_A05_L, C_A06_L, C_A07_L, C_A08_L};
    for (int j = 8; j >= 0; j--) {
        float mh, ml;
        PairMul(wh, wl, ah, al, mh, ml);
        PairAdd(ch[j], cl[j], mh, ml, ah, al);
    }
    float sh2, sl2;
    PairMul(vh, vl, ah, al, sh2, sl2);  // S = v*acc；ln(1+u) = 2S
    float s2h = 2.0f * sh2, s2l = 2.0f * sl2;
    float l2h, l2l;
    PairMul(s2h, s2l, C_ILN2_H, C_ILN2_L, l2h, l2l);  // log2(m) = 2S/ln2
    PairAdd((float)k, 0.0f, l2h, l2l, lh, ll);
}

// z = 2^t（pair t），2^k 用倒数幂表 + 幂对幂精确除法构造
__aicore__ inline void Exp2Pair(float th, float tl, float& zh, float& zl, const float* negPow)
{
    int i = (int)th;
    if ((float)i > th) i--;
    float k = (float)i;
    float rh, rl;
    PairAdd(th, tl, -k, 0.0f, rh, rl);          // r = t - k in [0,1)
    float qh, ql;
    PairMul(rh, rl, C_LN2_H, C_LN2_L, qh, ql);  // q = r*ln2
    const float ch[12] = {C_E11_H, C_E10_H, C_E09_H, C_E08_H, C_E07_H, C_E06_H,
                          C_E05_H, C_E04_H, C_E03_H, C_E02_H, C_E01_H, C_E00_H};
    const float cl[12] = {C_E11_L, C_E10_L, C_E09_L, C_E08_L, C_E07_L, C_E06_L,
                          C_E05_L, C_E04_L, C_E03_L, C_E02_L, C_E01_L, C_E00_L};
    float ah = ch[0], al = cl[0];
    for (int j = 1; j < 12; j++) {
        float mh, ml;
        PairMul(qh, ql, ah, al, mh, ml);
        PairAdd(ch[j], cl[j], mh, ml, ah, al);
    }
    float pk;
    if (i > 127) {
        pk = 0x1p127f * 2.0f;                   // -> inf
    } else if (i >= 0) {
        pk = 1.0f / negPow[i];                  // IEEE 幂对幂除法精确
    } else if (i >= -127) {
        pk = negPow[-i];
    } else {
        pk = 0.0f;                              // 下溢退化
    }
    zh = ah * pk;
    zl = al * pk;
}

// inv_freq[i] = fl(1 / fl(theta^e))，e = fl(2i/dim)（标量 IEEE RN 除法）
__aicore__ inline float InvFreqElem(float lh, float ll, int i, float dimf, const float* negPow)
{
    float e = (2.0f * (float)i) / dimf;
    float p1, e1;
    TwoProd(e, lh, p1, e1);
    float p2 = e * ll;
    float s = e1 + p2;
    float th, tl;
    QuickTwoSum(p1, s, th, tl);
    float zh, zl;
    Exp2Pair(th, tl, zh, zl, negPow);
    float zf = zh + zl;                         // 单次舍入 = 正确舍入的 theta^e
    return 1.0f / zf;
}

// Cody-Waite 三项预缩减常量（θ ≤ 131071 > Sin/Cos 输入范围 [-65504,65504]，需预缩减）
static constexpr float P_INV2PI = 0.159154937744140625f;  // fl32(1/(2*pi))
static constexpr float P_HI     = 6.28125f;               // 8 位有效位
static constexpr float P_MID    = 0.00193023681640625f;   // 253 * 2^-17，9 位有效位
static constexpr float P_LO     = 5.0703632e-06f;         // fl32(2*pi - HI - MID)

static constexpr int64_t PIPE_DEPTH = 2;        // O1：TQue 双缓冲
static constexpr int64_t POS_BATCH_ROWS = 512;  // positions 分批搬运行数
static constexpr uint32_t SIN_COS_TMP_SIZE = 8192;  // O4：Sin/Cos 共享临时 8KB
static constexpr int64_t MAX_HS = 200;          // repeatTimes ≤ 255 硬限

__aicore__ inline int64_t MinI64(int64_t a, int64_t b) { return a < b ? a : b; }
__aicore__ inline int64_t MaxI64(int64_t a, int64_t b) { return a > b ? a : b; }

// ============================================================================
// Kernel 主体：每核一个实例，head-row 连续切分（方案 §4/§5/§7）
// ============================================================================
// ROWGRP：编译期行组开关（P4 模式 B）。host 按 Grp>1 实例化——false 实例完全
// 不含行组代码（实测运行时分支等价重构仍使模式 A 标量调度劣化 +24%，小 case 放大）
template <typename T, bool ROWGRP>
class KernelRotaryPosEmb {
public:
    __aicore__ inline KernelRotaryPosEmb() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
                                int64_t B, int64_t S, int64_t H, int64_t dim,
                                int64_t W, int64_t Hs, int64_t Mc, int64_t Grp, float theta)
    {
        blockIdx_ = AscendC::GetBlockIdx();
        H_ = H; dim_ = dim; C_ = dim / 2; theta_ = theta;
        Hs_ = Hs; Mc_ = Mc;
        // P4 RowGroup：Grp>1 时 tile = Grp 行 x 单 head（host 保证此时 Hs=1），
        // 角度链按行组批处理（H 个 head tile 复用），旋转 rep=Grp
        Grp_ = Grp;
        bufRows_ = ROWGRP ? Grp : Hs;
        NHR_ = B * S * H;
        myStart_ = blockIdx_ * W;
        myEnd_ = MinI64(NHR_, myStart_ + W);
        active_ = myStart_ < NHR_;
        if (!active_) {
            return;
        }
        r0_ = myStart_ / H;
        r1_ = (myEnd_ + H - 1) / H;
        rowsThisCore_ = r1_ - r0_;
        posBatchRows_ = MinI64(rowsThisCore_, POS_BATCH_ROWS);

        const int64_t isize = (int64_t)sizeof(T);
        fast_ = (C_ * isize) % 32 == 0;
        pitchC_ = (C_ + 7) / 8 * 8;                    // cos/sin 行 pitch（32B 对齐）
        P16_ = (C_ + 15) / 16 * 16;                    // fp16 32B pitch
        P32_ = (C_ + 7) / 8 * 8;                       // fp32 32B pitch
        // 快路径行紧致 pitch=C；慢路径 UB 行 32B pitch
        pitchF_ = fast_ ? C_ : P32_;                   // fp32 中间量行 pitch
        pitchY_ = fast_ ? C_ : ((int64_t)sizeof(T) == 2 ? P16_ : P32_);   // y 输出行 pitch
        pitchX_ = fast_ ? dim_ : ((int64_t)sizeof(T) == 2 ? P16_ : P32_); // x 输入行 pitch

        xGm_.SetGlobalBuffer((__gm__ T *)x, B * S * H * dim);
        posGm_.SetGlobalBuffer((__gm__ int32_t *)positions, B * S);
        yGm_.SetGlobalBuffer((__gm__ T *)y, B * S * H * dim);

        InitBuffers(isize);
    }

    // O1 三级流水：CopyIn(t+1) ∥ Compute(t) ∥ CopyOut(t-1)
    __aicore__ inline void Process()
    {
        if (!active_) {
            return;
        }
        // inv_freq 生成（SPCPU 标量 pair-pow），与首批 MTE2 搬运重叠
        float negPow[128];
        {
            float p = 1.0f;
            for (int j = 0; j < 128; j++) { negPow[j] = p; p = p * 0.5f; }
        }
        float lh, ll;
        Log2Pair(theta_, lh, ll);
        for (int64_t i = 0; i < C_; i++) {
            invfT_.SetValue(i, InvFreqElem(lh, ll, (int)i, (float)dim_, negPow));
        }
        // SPCPU 写 UB -> V 读：显式全量屏障（probe 验证形态）
        AscendC::PipeBarrier<PIPE_ALL>();

        if constexpr (ROWGRP) {
            ProcessRowGroup();
            return;
        }

        // tile 游标：(row, hb, hc)
        int64_t r = r0_;
        int64_t hb = H0OfRow(r0_);
        int64_t hc = TileHeadCount(r, hb);

        // 序幕：pos 批次(0) + CopyIn(tile 0) 先行下发
        IssuePosBatchIfNew(r);
        CopyInTile(r, hb, hc);

        while (true) {
            // 预发下一 tile 的 pos 批次与 CopyIn（MTE2 顺序：pos 先于下一 x tile，
            // 使 V 侧 DeQue(pos) 不被 x 搬运阻塞）
            int64_t nr = r;
            int64_t nhb = hb;
            bool hasNext = AdvanceTile(nr, nhb);
            if (hasNext) {
                IssuePosBatchIfNew(nr);
                CopyInTile(nr, nhb, TileHeadCount(nr, nhb));
            }
            ComputeTile(r, hb, hc, 0);
            CopyOutTile(r, hb, hc);
            if (!hasNext) {
                break;
            }
            r = nr;
            hb = nhb;
            hc = TileHeadCount(r, hb);
        }
    }

private:
    __aicore__ inline int64_t H0OfRow(int64_t r) const
    {
        return (r == r0_) ? (myStart_ % H_) : 0;
    }

    __aicore__ inline int64_t H1OfRow(int64_t r) const
    {
        if (r == r1_ - 1) {
            int64_t rem = myEnd_ % H_;
            return (rem == 0) ? H_ : rem;
        }
        return H_;
    }

    __aicore__ inline int64_t TileHeadCount(int64_t r, int64_t hb) const
    {
        return MinI64(Hs_, H1OfRow(r) - hb);
    }

    // 前进到下一 tile；无下一 tile 时返回 false
    __aicore__ inline bool AdvanceTile(int64_t& r, int64_t& hb) const
    {
        int64_t next = hb + Hs_;
        if (next < H1OfRow(r)) {
            hb = next;
            return true;
        }
        int64_t nr = r + 1;
        if (nr >= r1_) {
            return false;
        }
        r = nr;
        hb = H0OfRow(nr);
        return true;
    }

    int64_t PosBatchIndexOfRow(int64_t r) const { return (r - r0_) / posBatchRows_; }

    // ================= P4 RowGroup（fast 且 H 较小，host 判定 Grp>1 启用） =================

    // pos 批次 Cast（模式 A/B 共用；原 ComputeTile 内逻辑抽出）
    __aicore__ inline void ComputePosCastIfNew(int64_t r)
    {
        int64_t bIdx = PosBatchIndexOfRow(r);
        if (bIdx == posCastBatch_) {
            return;
        }
        auto posT = inQuePos_.DeQue<int32_t>();
        AscendC::Cast<float, int32_t>(posFT_, posT, AscendC::RoundMode::CAST_NONE,
                                      static_cast<uint32_t>(posBatchCount_));
        inQuePos_.FreeTensor(posT);
        posCastBatch_ = bIdx;
        // V 写 -> SPCPU 标量读：PIPE_V 屏障 + V_S 硬件事件（canonical 形态）
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_S>(static_cast<event_t>(eventVS_));
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(static_cast<event_t>(eventVS_));
    }

    // 行组角度链批处理：G 行的 ang 拼接为 [G*C] 连续向量，Muls(pos) 逐行、
    // Cody-Waite 缩减链 8 条大指令拼接、Sin/Cos 512 元素分块拼接，产出
    // cosT_/sinT_ [G, pitchC]（fp32，两 dtype 旋转共用）。H 个 head tile 复用。
    __aicore__ inline void ComputeAngleGroup(int64_t rg, int64_t g)
    {
        const int64_t bIdx = PosBatchIndexOfRow(rg);
        const int64_t row0 = r0_ + bIdx * posBatchRows_;
        for (int64_t i = 0; i < g; i++) {
            float pos = posFT_.GetValue(rg + i - row0);
            AscendC::Muls(angT_[i * C_], invfT_, pos, static_cast<int32_t>(C_));
        }
        const int64_t cnt = g * C_;
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(kT_, angT_, P_INV2PI, static_cast<int32_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Round(kT_, kT_, static_cast<int32_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(tT_, kT_, P_HI, static_cast<int32_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(redT_, angT_, tT_, static_cast<int32_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(tT_, kT_, P_MID, static_cast<int32_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(redT_, redT_, tT_, static_cast<int32_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(tT_, kT_, P_LO, static_cast<int32_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(redT_, redT_, tT_, static_cast<int32_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
        // P4b：Sin/Cos 分块批处理——[G*C] 按 512 元素（16 行）分块拼接调用，
        // 打头摊薄 16x。注：单次 count=G*C(3424) 实测挂死（tmp 上限），负结果留痕
        constexpr int64_t SIN_BLK = 512;
        for (int64_t o = 0; o < cnt; o += SIN_BLK) {
            const uint32_t n = static_cast<uint32_t>(MinI64(SIN_BLK, cnt - o));
            AscendC::Sin(sinT_[o], redT_[o], tmpT_, n);
        }
        AscendC::PipeBarrier<PIPE_V>();
        for (int64_t o = 0; o < cnt; o += SIN_BLK) {
            const uint32_t n = static_cast<uint32_t>(MinI64(SIN_BLK, cnt - o));
            AscendC::Cos(cosT_[o], redT_[o], tmpT_, n);
        }
        AscendC::PipeBarrier<PIPE_V>();
        // P3 回退后 cosT_/sinT_（fp32，[G, pitchC]）直接供两 dtype 旋转使用
    }

    // 行组 tile 搬入：G 行 x 单 head 的 2D strided（GM srcStride 为字节 gap，
    // 块距 = dim*isize + (H-1)*dim*isize = H*dim*isize，即跨 (b,s) 行取同 head）
    __aicore__ inline void CopyInTileRG(int64_t rg, int64_t hb, int64_t g)
    {
        auto xT = inQueX_.AllocTensor<T>();
        int64_t gmIdx = (rg * H_ + hb) * dim_;
        AscendC::DataCopyExtParams cp{
            static_cast<uint16_t>(g),
            static_cast<uint32_t>(dim_ * sizeof(T)),
            static_cast<uint32_t>((H_ - 1) * dim_ * sizeof(T)), 0, 0};
        AscendC::DataCopyPadExtParams<T> pp{false, 0, 0, 0};
        AscendC::DataCopyPad(xT, xGm_[gmIdx], cp, pp);
        inQueX_.EnQue(xT);
    }

    // 行组 tile 搬出：对称 2D strided（UB srcStride=0 紧凑，GM dstStride 字节 gap）
    __aicore__ inline void CopyOutTileRG(int64_t rg, int64_t hb, int64_t g)
    {
        auto yT = outQueY_.DeQue<T>();
        int64_t gmIdx = (rg * H_ + hb) * dim_;
        AscendC::DataCopyExtParams cp{
            static_cast<uint16_t>(g),
            static_cast<uint32_t>(dim_ * sizeof(T)), 0,
            static_cast<uint32_t>((H_ - 1) * dim_ * sizeof(T)), 0};
        AscendC::DataCopyPad(yGm_[gmIdx], yT, cp);
        outQueY_.FreeTensor(yT);
    }

    // 行组 tile 计算：角度链已由 ComputeAngleGroup 预处理，此处仅旋转（rep=g，
    // cos/sin 按行取（src1RepStride=行 pitch），无广播）
    __aicore__ inline void ComputeTileRG(int64_t rg, int64_t hb, int64_t g)
    {
        (void)rg; (void)hb;
        auto xT = inQueX_.DeQue<T>();
        auto yT = outQueY_.AllocTensor<T>();
        if constexpr (sizeof(T) == 2) {
            RotateFastFp16(xT, yT, g, cosT_, sinT_, static_cast<uint8_t>(pitchC_ / 8));
        } else {
            RotateFastFp32(xT, yT, g, cosT_, sinT_, static_cast<uint8_t>(pitchC_ / 8));
        }
        outQueY_.EnQue(yT);
        inQueX_.FreeTensor(xT);
    }

    // 核边界 partial 行（head 范围不整）：单行 x 单 head tile（模式 A 逻辑，Hs=1）
    __aicore__ inline void ProcessSingleRowTiles(int64_t r)
    {
        int64_t hb = H0OfRow(r);
        const int64_t h1 = H1OfRow(r);
        IssuePosBatchIfNew(r);
        CopyInTile(r, hb, 1);
        while (hb < h1) {
            if (hb + 1 < h1) {
                CopyInTile(r, hb + 1, 1);
            }
            ComputeTile(r, hb, 1, 0);
            CopyOutTile(r, hb, 1);
            hb++;
        }
    }

    // P4 主循环：partial 首尾行走单行 tile，完整行走 Grp 行组（角度链组内批处理 +
    // H 个 head tile 复用；组内 hb 循环保持 CopyIn(hb+1) ∥ Compute(hb) ∥ CopyOut(hb-1)）
    __aicore__ inline void ProcessRowGroup()
    {
        const bool firstPartial = (myStart_ % H_) != 0;
        const bool lastPartial = (myEnd_ % H_) != 0 && (!firstPartial || r1_ - 1 > r0_);
        if (firstPartial) {
            ProcessSingleRowTiles(r0_);
        }
        const int64_t r0f = firstPartial ? r0_ + 1 : r0_;
        const int64_t r1f = ((myEnd_ % H_) != 0) ? r1_ - 1 : r1_;
        for (int64_t rg = r0f; rg < r1f; rg += Grp_) {
            // 组不跨 posBatch（512 行）边界：角度链一次读 G 行 posFT_，
            // 跨界会读到未 cast 的下批数据（实测 matched 0.894 即此因）
            const int64_t bIdx = PosBatchIndexOfRow(rg);
            const int64_t batchEnd = r0_ + (bIdx + 1) * posBatchRows_;
            int64_t g = MinI64(MinI64(Grp_, r1f - rg), batchEnd - rg);
            if (g < 1) {
                g = 1;
            }
            IssuePosBatchIfNew(rg);
            CopyInTileRG(rg, 0, g);
            ComputePosCastIfNew(rg);
            ComputeAngleGroup(rg, g);
            for (int64_t hb = 0; hb < H_; hb++) {
                if (hb + 1 < H_) {
                    CopyInTileRG(rg, hb + 1, g);
                }
                ComputeTileRG(rg, hb, g);
                CopyOutTileRG(rg, hb, g);
            }
            // 步进按实际处理行数：batch 边界截断的组（g<Grp）后若按 Grp 步进
            // 会跳过 Grp-g 行（实测每 batch 首 23 行输出全 0）
            rg += g - Grp_;
        }
        if (lastPartial) {
            ProcessSingleRowTiles(r1_ - 1);
        }
    }

    __aicore__ inline void IssuePosBatchIfNew(int64_t r)
    {
        int64_t bIdx = PosBatchIndexOfRow(r);
        if (bIdx == posIssuedBatch_) {
            return;
        }
        int64_t rowBegin = r0_ + bIdx * posBatchRows_;
        int64_t rowEnd = MinI64(rowBegin + posBatchRows_, r1_);
        int64_t count = rowEnd - rowBegin;
        auto posT = inQuePos_.AllocTensor<int32_t>();
        AscendC::DataCopyExtParams cp{1, static_cast<uint32_t>(count * sizeof(int32_t)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<int32_t> pp{false, 0, 0, 0};
        AscendC::DataCopyPad(posT, posGm_[rowBegin], cp, pp);
        inQuePos_.EnQue(posT);
        posIssuedBatch_ = bIdx;
        posBatchCount_ = count;
    }

    // ================= 快/慢路径搬运 =================

    __aicore__ inline void CopyInTile(int64_t r, int64_t hb, int64_t hc)
    {
        auto xT = inQueX_.AllocTensor<T>();
        if (fast_) {
            // 整行 head-block 1D flat 连续搬（天然 32B 对齐）
            int64_t gmIdx = (r * H_ + hb) * dim_;
            AscendC::DataCopyExtParams cp{
                1, static_cast<uint32_t>(hc * dim_ * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pp{false, 0, 0, 0};
            AscendC::DataCopyPad(xT, xGm_[gmIdx], cp, pp);
        } else {
            // 慢路径：逐 head 1D DataCopyPad 搬 x1/x2（GM 侧任意字节偏移，probe B1 验证）
            AscendC::DataCopyExtParams cp{1, static_cast<uint32_t>(C_ * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pp{false, 0, 0, 0};
            for (int64_t i = 0; i < hc; i++) {
                int64_t gmIdx = (r * H_ + hb + i) * dim_;
                AscendC::DataCopyPad(xT[i * pitchX_], xGm_[gmIdx], cp, pp);
                AscendC::DataCopyPad(xT[(Hs_ + i) * pitchX_], xGm_[gmIdx + C_], cp, pp);
            }
        }
        inQueX_.EnQue(xT);
    }

    __aicore__ inline void CopyOutTile(int64_t r, int64_t hb, int64_t hc)
    {
        int64_t gmIdx = (r * H_ + hb) * dim_;
        if (fast_) {
            // P1：合并 y tensor（行 pitch=dim）整 tile 1D 连续写出。原 2 组 2D 写出中
            // y2 组 GM 基址偏移 C·isize 字节，fp16/C=32 时为 64B 非 128B 对齐，MTE3 按
            // 128B 粒度写导致 ~2x 写放大（fp32/C=32 偏移 128B、fp16/C=512 偏移 1024B
            // 恰好对齐故 1x，与 4.1 实测吻合）。
            auto yT = outQueY_.DeQue<T>();
            AscendC::DataCopyExtParams cp{
                1, static_cast<uint32_t>(hc * dim_ * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(yGm_[gmIdx], yT, cp);
            outQueY_.FreeTensor(yT);
            return;
        }
        auto y1T = outQueY1_.DeQue<T>();
        auto y2T = outQueY2_.DeQue<T>();
        AscendC::DataCopyExtParams cp{1, static_cast<uint32_t>(C_ * sizeof(T)), 0, 0, 0};
        for (int64_t i = 0; i < hc; i++) {
            AscendC::DataCopyPad(yGm_[gmIdx + i * dim_], y1T[i * pitchY_], cp);
            AscendC::DataCopyPad(yGm_[gmIdx + i * dim_ + C_], y2T[i * pitchY_], cp);
        }
        outQueY1_.FreeTensor(y1T);
        outQueY2_.FreeTensor(y2T);
    }

    // ================= 计算 =================

    // cosRow：本行 cos/sin 在角度链输出（cosT_/sinT_，单行形态写行 0）中的行偏移
    __aicore__ inline void ComputeTile(int64_t r, int64_t hb, int64_t hc, int64_t cosRow)
    {
        auto xT = inQueX_.DeQue<T>();
        // pos 批次：DeQue（TQue 内建 MTE2->V 事件同步）+ Cast -> posF
        ComputePosCastIfNew(r);
        if (r != angRow_) {
            ComputeAngleRow(r, PosBatchIndexOfRow(r));   // 单行角度链 -> cosT_/sinT_ 行 0
            angRow_ = r;
        }

        if (fast_) {
            // P1：fast 路径单合并 y tensor（y1 -> 列段 [0,C)，y2 -> 列段 [C,dim)）
            auto yT = outQueY_.AllocTensor<T>();
            if constexpr (sizeof(T) == 2) {
                RotateFastFp16(xT, yT, hc, cosT_[cosRow * pitchC_], sinT_[cosRow * pitchC_], 0);
            } else {
                RotateFastFp32(xT, yT, hc, cosT_[cosRow * pitchC_], sinT_[cosRow * pitchC_], 0);
            }
            outQueY_.EnQue(yT);
        } else {
            auto y1T = outQueY1_.AllocTensor<T>();
            auto y2T = outQueY2_.AllocTensor<T>();
            if constexpr (sizeof(T) == 2) {
                RotateSlowFp16(xT, y1T, y2T, hc);
            } else {
                RotateSlowFp32(xT, y1T, y2T, hc);
            }
            outQueY1_.EnQue(y1T);
            outQueY2_.EnQue(y2T);
        }
        inQueX_.FreeTensor(xT);
    }

    // 角度链：ang = pos*invf -> Cody-Waite 预缩减 -> Sin/Cos（方案 §2.2，probe C/C2 验证）
    __aicore__ inline void ComputeAngleRow(int64_t r, int64_t bIdx)
    {
        int64_t rowInBatch = r - (r0_ + bIdx * posBatchRows_);
        float pos = posFT_.GetValue(rowInBatch);
        AscendC::Muls(angT_, invfT_, pos, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(kT_, angT_, P_INV2PI, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Round(kT_, kT_, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(tT_, kT_, P_HI, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(redT_, angT_, tT_, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(tT_, kT_, P_MID, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(redT_, redT_, tT_, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(tT_, kT_, P_LO, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(redT_, redT_, tT_, static_cast<int32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sin(sinT_, redT_, tmpT_, static_cast<uint32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cos(cosT_, redT_, tmpT_, static_cast<uint32_t>(C_));
        AscendC::PipeBarrier<PIPE_V>();
    }

    // O2：ARA 批量旋转（repeat=tile head 数、src1RepStride=0 广播 cos/sin、Mc 列分块）。
    // P3（数值路径变更，CPU 仿真 4 场景 + 上板权威断言）：fast fp16 路径改为 half 元素
    // 直接运算——cos/sin 经 CAST_ROUND 单次舍入到 fp16（cosHT_/sinHT_），乘/减/加在
    // fp16 域单次舍入，y1/y2 的 mul-then-add 次序与 golden 一致；指令 10->6 条/列块、
    // barrier 5->3，mask 走 128 位数组版（Mc=min(C,128)，方案 §4 勘误预留的 half 直
    // 运算路径）。fp32 fast 与全部慢路径保持 fp32 中间域逐位对齐编排不变。
    // P3（fp16 直乘）已回退：bands 极值用例（±65504 配对抵消，|golden|~6.6e3 时
    // fp16 中间舍入误差 32-64 > 容差 12.8）权威断言 matched 0.988 < 0.99 FAIL，
    // 详见性能迭代记录。fp16 旋转恢复 fp32 中间域逐位对齐编排（与 golden mul-then-add
    // 次序一致）。s1Rep：cos/sin 的 src1RepStride（fp32 块）——模式 A 广播=0，
    // 模式 B（RowGroup）逐行取 = pitchC/8（cosT_ 排布 [G, pitchC]）
    __aicore__ inline void RotateFastFp16(const AscendC::LocalTensor<half>& xT,
                                          const AscendC::LocalTensor<half>& yT, int64_t hc,
                                          const AscendC::LocalTensor<float>& cosBase,
                                          const AscendC::LocalTensor<float>& sinBase,
                                          uint8_t s1Rep)
    {
        const uint8_t rep = static_cast<uint8_t>(hc);
        const uint8_t sX = static_cast<uint8_t>(dim_ / 16);   // xTile 行 pitch（fp16 块）
        const uint8_t sF = static_cast<uint8_t>(C_ / 8);      // fp32 中间量行 pitch（fp32 块）
        const uint8_t sY = static_cast<uint8_t>(dim_ / 16);   // y 合并行 pitch=dim（fp16 块）
        // P7：4 temp 同址编排（x1f/x2f/y1f/y2f，t1/t2 中转取消）——数值路径与原
        // 6 temp 编排位级等价（fp32 域同 mul-then-add 次序），temp 6->4 份使
        // hs 上调（大 C case rep 加宽）。y2f/x1f 的覆盖写在读后（barrier 保护）。
        for (int64_t j = 0; j < C_; j += Mc_) {
            const uint64_t mask = static_cast<uint64_t>(MinI64(Mc_, C_ - j));
            AscendC::Cast<float, half>(x1fT_[j], xT[j], AscendC::RoundMode::CAST_NONE, mask, rep,
                                       AscendC::UnaryRepeatParams{1, 1, sF, sX});
            AscendC::Cast<float, half>(x2fT_[j], xT[C_ + j], AscendC::RoundMode::CAST_NONE, mask, rep,
                                       AscendC::UnaryRepeatParams{1, 1, sF, sX});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul<float>(y1fT_[j], x1fT_[j], cosBase[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, s1Rep});
            AscendC::Mul<float>(y2fT_[j], x2fT_[j], sinBase[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, s1Rep});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub<float>(y1fT_[j], y1fT_[j], y2fT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, sF});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul<float>(y2fT_[j], x2fT_[j], cosBase[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, s1Rep});
            AscendC::Mul<float>(x1fT_[j], x1fT_[j], sinBase[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, s1Rep});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add<float>(y2fT_[j], y2fT_[j], x1fT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, sF});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast<half, float>(yT[j], y1fT_[j], AscendC::RoundMode::CAST_ROUND, mask, rep,
                                       AscendC::UnaryRepeatParams{1, 1, sY, sF});
            AscendC::Cast<half, float>(yT[C_ + j], y2fT_[j], AscendC::RoundMode::CAST_ROUND, mask, rep,
                                       AscendC::UnaryRepeatParams{1, 1, sY, sF});
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    // s1Rep：cos/sin 的 src1RepStride（fp32 块）——模式 A 广播=0，
    // 模式 B（RowGroup）逐行取 = pitchC/8（cosT_ 排布 [G, pitchC]）
    __aicore__ inline void RotateFastFp32(const AscendC::LocalTensor<float>& xT,
                                          const AscendC::LocalTensor<float>& yT, int64_t hc,
                                          const AscendC::LocalTensor<float>& cosBase,
                                          const AscendC::LocalTensor<float>& sinBase,
                                          uint8_t s1Rep)
    {
        const uint8_t rep = static_cast<uint8_t>(hc);
        const uint8_t sX = static_cast<uint8_t>(dim_ / 8);    // xTile 行 pitch（fp32 块）
        const uint8_t sF = static_cast<uint8_t>(C_ / 8);      // t2 行 pitch（fp32 块）
        const uint8_t sY = static_cast<uint8_t>(dim_ / 8);    // y 合并行 pitch=dim（fp32 块）
        // P7：1 temp（t2）同址编排——y1/y2 直写输出列段，temp 2->1 份
        for (int64_t j = 0; j < C_; j += Mc_) {
            uint64_t mask = static_cast<uint64_t>(MinI64(Mc_, C_ - j));
            AscendC::Mul<float>(yT[j], xT[j], cosBase[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sY, sX, s1Rep});
            AscendC::Mul<float>(t2T_[j], xT[C_ + j], sinBase[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sX, s1Rep});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub<float>(yT[j], yT[j], t2T_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sY, sY, sF});
            AscendC::Mul<float>(yT[C_ + j], xT[C_ + j], cosBase[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sY, sX, s1Rep});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul<float>(t2T_[j], xT[j], sinBase[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sX, s1Rep});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add<float>(yT[C_ + j], yT[C_ + j], t2T_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sY, sY, sF});
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    // 慢路径：x1/x2 行已在 inQueueX 张量的 32B pitch 行槽，计算同快路径编排
    __aicore__ inline void RotateSlowFp16(const AscendC::LocalTensor<half>& xT,
                                          const AscendC::LocalTensor<half>& y1T,
                                          const AscendC::LocalTensor<half>& y2T, int64_t hc)
    {
        const uint8_t rep = static_cast<uint8_t>(hc);
        const uint8_t sX = static_cast<uint8_t>(P16_ / 16);
        const uint8_t sF = static_cast<uint8_t>(P32_ / 8);
        const uint8_t sY = static_cast<uint8_t>(P16_ / 16);
        const int64_t x2Base = Hs_ * P16_;
        for (int64_t j = 0; j < C_; j += Mc_) {
            uint64_t mask = static_cast<uint64_t>(MinI64(Mc_, C_ - j));
            AscendC::Cast<float, half>(x1fT_[j], xT[j], AscendC::RoundMode::CAST_NONE, mask, rep,
                                       AscendC::UnaryRepeatParams{1, 1, sF, sX});
            AscendC::Cast<float, half>(x2fT_[j], xT[x2Base + j], AscendC::RoundMode::CAST_NONE, mask, rep,
                                       AscendC::UnaryRepeatParams{1, 1, sF, sX});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul<float>(t1T_[j], x1fT_[j], cosT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, 0});
            AscendC::Mul<float>(t2T_[j], x2fT_[j], sinT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, 0});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub<float>(y1fT_[j], t1T_[j], t2T_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, sF});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul<float>(t1T_[j], x2fT_[j], cosT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, 0});
            AscendC::Mul<float>(t2T_[j], x1fT_[j], sinT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, 0});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add<float>(y2fT_[j], t1T_[j], t2T_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sF, sF, sF});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast<half, float>(y1T[j], y1fT_[j], AscendC::RoundMode::CAST_ROUND, mask, rep,
                                       AscendC::UnaryRepeatParams{1, 1, sY, sF});
            AscendC::Cast<half, float>(y2T[j], y2fT_[j], AscendC::RoundMode::CAST_ROUND, mask, rep,
                                       AscendC::UnaryRepeatParams{1, 1, sY, sF});
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void RotateSlowFp32(const AscendC::LocalTensor<float>& xT,
                                          const AscendC::LocalTensor<float>& y1T,
                                          const AscendC::LocalTensor<float>& y2T, int64_t hc)
    {
        const uint8_t rep = static_cast<uint8_t>(hc);
        const uint8_t sX = static_cast<uint8_t>(P32_ / 8);
        const int64_t x2Base = Hs_ * P32_;
        for (int64_t j = 0; j < C_; j += Mc_) {
            uint64_t mask = static_cast<uint64_t>(MinI64(Mc_, C_ - j));
            AscendC::Mul<float>(t1T_[j], xT[j], cosT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sX, sX, 0});
            AscendC::Mul<float>(t2T_[j], xT[x2Base + j], sinT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sX, sX, 0});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub<float>(y1T[j], t1T_[j], t2T_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sX, sX, sX});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul<float>(t1T_[j], xT[x2Base + j], cosT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sX, sX, 0});
            AscendC::Mul<float>(t2T_[j], xT[j], sinT_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sX, sX, 0});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add<float>(y2T[j], t1T_[j], t2T_[j], mask, rep,
                                AscendC::BinaryRepeatParams{1, 1, 1, sX, sX, sX});
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    // ================= Buffer 规划（方案 §3） =================

    __aicore__ inline void InitBuffers(int64_t isize)
    {
        // VECCALC 子缓冲布局（全部 32B 对齐偏移）
        uint32_t off = 0;
        auto align32 = [](uint32_t v) -> uint32_t { return (v + 31u) / 32u * 32u; };
        // P4/P5：角度链行组拼接为 [Grp*C] 连续向量 / cos/sin [Grp,pitchC]
        // （Grp_=1 时即原单行量，两模式统一）
        const int64_t rowsA = Grp_;
        const uint32_t szC = static_cast<uint32_t>(C_ * 4);
        const uint32_t szAng = static_cast<uint32_t>(rowsA * C_ * 4);
        const uint32_t szPitchC = static_cast<uint32_t>(rowsA * pitchC_ * 4);
        invfOff_ = off;  off = align32(off + szC);
        angOff_  = off;  off = align32(off + szAng);
        kOff_    = off;  off = align32(off + szAng);
        tOff_    = off;  off = align32(off + szAng);
        redOff_  = off;  off = align32(off + szAng);
        cosOff_  = off;  off = align32(off + szPitchC);
        sinOff_  = off;  off = align32(off + szPitchC);
        posFOff_ = off;  off = align32(off + static_cast<uint32_t>(posBatchRows_ * 4));
        tmpOff_  = off;  off = align32(off + SIN_COS_TMP_SIZE);
        // 中间量：P7 fast 同址编排——fp16 4 份（x1f/x2f/y1f/y2f）、fp32 1 份（t2）；
        // 慢路径不变（fp16 6 份、fp32 2 份，pitchX 行槽形态）
        const int64_t nTemp = fast_
            ? ((isize == 2) ? 4 : 1)
            : ((isize == 2) ? 6 : 2);
        const uint32_t szTemp = static_cast<uint32_t>(bufRows_ * pitchF_ * 4);
        tempOff_[0] = off;
        for (int64_t i = 1; i < nTemp; i++) {
            tempOff_[i] = align32(tempOff_[i - 1] + szTemp);
        }
        off = align32(tempOff_[nTemp - 1] + szTemp);
        vecCalcBytes_ = off;

        pipe_.InitBuffer(calcBuf_, vecCalcBytes_);
        pipe_.InitBuffer(inQueX_, static_cast<uint8_t>(PIPE_DEPTH),
                         static_cast<uint32_t>(fast_ ? bufRows_ * dim_ * isize
                                                     : 2 * Hs_ * pitchX_ * isize));
        if (fast_) {
            // P1：fast 路径合并 y1/y2 为单 VECOUT tensor（行 pitch=dim），1D 连续写出
            pipe_.InitBuffer(outQueY_, static_cast<uint8_t>(PIPE_DEPTH),
                             static_cast<uint32_t>(bufRows_ * dim_ * isize));
        } else {
            pipe_.InitBuffer(outQueY1_, static_cast<uint8_t>(PIPE_DEPTH),
                             static_cast<uint32_t>(Hs_ * pitchY_ * isize));
            pipe_.InitBuffer(outQueY2_, static_cast<uint8_t>(PIPE_DEPTH),
                             static_cast<uint32_t>(Hs_ * pitchY_ * isize));
        }
        pipe_.InitBuffer(inQuePos_, static_cast<uint8_t>(PIPE_DEPTH),
                         static_cast<uint32_t>((posBatchRows_ * sizeof(int32_t) + 31) / 32 * 32));

        auto calcB = calcBuf_.Get<uint8_t>();
        auto calcF = calcB.ReinterpretCast<float>();
        // V->S 标量读事件（posF GetValue 前的 V_S 同步，串行复用同一 event id）
        eventVS_ = pipe_.FetchEventID(AscendC::HardEvent::V_S);
        invfT_ = calcF[invfOff_ / 4];
        angT_  = calcF[angOff_ / 4];
        kT_    = calcF[kOff_ / 4];
        tT_    = calcF[tOff_ / 4];
        redT_  = calcF[redOff_ / 4];
        cosT_  = calcF[cosOff_ / 4];
        sinT_  = calcF[sinOff_ / 4];
        posFT_ = calcF[posFOff_ / 4];
        tmpT_  = calcB[tmpOff_];
        if (fast_ && isize == 2) {
            // P7：fast fp16 4 temp 同址编排
            x1fT_ = calcF[tempOff_[0] / 4];
            x2fT_ = calcF[tempOff_[1] / 4];
            y1fT_ = calcF[tempOff_[2] / 4];
            y2fT_ = calcF[tempOff_[3] / 4];
        } else if (fast_) {
            // P7：fast fp32 1 temp（t2）
            t2T_ = calcF[tempOff_[0] / 4];
        } else if (nTemp == 6) {
            // fp16 路径：x1f/x2f/t1/t2/y1f/y2f 六份 fp32 中间量
            x1fT_ = calcF[tempOff_[0] / 4];
            x2fT_ = calcF[tempOff_[1] / 4];
            t1T_  = calcF[tempOff_[2] / 4];
            t2T_  = calcF[tempOff_[3] / 4];
            y1fT_ = calcF[tempOff_[4] / 4];
            y2fT_ = calcF[tempOff_[5] / 4];
        } else {
            // fp32 路径：仅 t1/t2 两份（y 直接写入 outQueue 张量）
            t1T_ = calcF[tempOff_[0] / 4];
            t2T_ = calcF[tempOff_[1] / 4];
        }
    }

    // ---- 成员 ----
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, static_cast<int32_t>(PIPE_DEPTH)> inQueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, static_cast<int32_t>(PIPE_DEPTH)> outQueY_;  // P1 fast 合并
    AscendC::TQue<AscendC::TPosition::VECOUT, static_cast<int32_t>(PIPE_DEPTH)> outQueY1_;  // 慢路径
    AscendC::TQue<AscendC::TPosition::VECOUT, static_cast<int32_t>(PIPE_DEPTH)> outQueY2_;  // 慢路径
    AscendC::TQue<AscendC::TPosition::VECIN, static_cast<int32_t>(PIPE_DEPTH)> inQuePos_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> calcBuf_;

    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<int32_t> posGm_;
    AscendC::GlobalTensor<T> yGm_;

    AscendC::LocalTensor<float> invfT_, angT_, kT_, tT_, redT_, cosT_, sinT_, posFT_;
    AscendC::LocalTensor<float> x1fT_, x2fT_, t1T_, t2T_, y1fT_, y2fT_;
    AscendC::LocalTensor<uint8_t> tmpT_;
    uint32_t tempOff_[6] = {0, 0, 0, 0, 0, 0};
    uint32_t invfOff_ = 0, angOff_ = 0, kOff_ = 0, tOff_ = 0, redOff_ = 0;
    uint32_t cosOff_ = 0, sinOff_ = 0, posFOff_ = 0, tmpOff_ = 0;
    uint32_t vecCalcBytes_ = 0;

    int64_t blockIdx_ = 0;
    int64_t H_ = 0, dim_ = 0, C_ = 0;
    int64_t NHR_ = 0, myStart_ = 0, myEnd_ = 0;
    int64_t r0_ = 0, r1_ = 0, rowsThisCore_ = 0;
    int64_t Hs_ = 1, Mc_ = 1;
    int64_t Grp_ = 1, bufRows_ = 1;
    int64_t pitchC_ = 0, P16_ = 0, P32_ = 0, pitchF_ = 0, pitchY_ = 0, pitchX_ = 0;
    int64_t posBatchRows_ = 1, posBatchCount_ = 0;
    int64_t posIssuedBatch_ = -1, posCastBatch_ = -1, angRow_ = -1;
    int8_t eventVS_ = 0;  // TEventID：V_S 事件 id
    float theta_ = 10000.0f;
    bool active_ = false;
    bool fast_ = false;
};

}  // namespace rotary_emb_impl

template <typename T, bool ROWGRP>
__global__ __aicore__ __vector__ void rotary_pos_emb_custom(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
    int64_t B, int64_t S, int64_t H, int64_t dim, int64_t W, int64_t Hs, int64_t Mc, int64_t Grp,
    float theta)
{
    rotary_emb_impl::KernelRotaryPosEmb<T, ROWGRP> op;
    op.Init(x, positions, y, B, S, H, dim, W, Hs, Mc, Grp, theta);
    op.Process();
}

// ============================================================================
// run_kernel：host 侧 Tiling（方案 §7）+ 按 dtype 分派 launch
// ============================================================================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR positions, const TensorGroupInfo& info_positions, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
    float theta)
{
    (void)info_positions;
    (void)info_y;
    const TensorInfo& xi = info_x.tensors[0];
    const int64_t B = xi.shape[0];
    const int64_t S = xi.shape[1];
    const int64_t H = xi.shape[2];
    const int64_t dim = xi.shape[3];
    const int32_t dtype = xi.dtype;  // 0=fp32 1=fp16
    const int64_t isize = (dtype == 1) ? 2 : 4;
    const int64_t C = dim / 2;
    const int64_t NHR = B * S * H;

    // 多核切分：head-row 连续切分（方案 §5）
    int64_t blockNum = (availableCoreNum > 0) ? availableCoreNum : 1;
    if (blockNum > NHR) {
        blockNum = NHR;
    }
    const int64_t W = (NHR + blockNum - 1) / blockNum;

    // UB 容量运行时查询（编码红线 B1：禁止硬编码）
    auto mgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (mgr == nullptr) {
        // 线上平台禁止调试输出，错误路径静默返回（本地调试可临时恢复）
        return;
    }
    uint64_t ubSize = 0;
    mgr->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    if (ubSize == 0) {
        // 线上平台禁止调试输出，错误路径静默返回（本地调试可临时恢复）
        return;
    }
    int64_t budget = static_cast<int64_t>(ubSize);
    const int64_t UB_BUDGET_CAP = 176 * 1024;  // 方案 §3 预算上界
    if (budget > UB_BUDGET_CAP) {
        budget = UB_BUDGET_CAP;
    }

    // Buffer 预算反推 Hs（方案 §3/§7）
    const int64_t pitchC = (C + 7) / 8 * 8;
    const int64_t P16 = (C + 15) / 16 * 16;
    const int64_t P32 = (C + 7) / 8 * 8;
    const bool fast = (C * isize) % 32 == 0;
    const int64_t pitchF = fast ? C : P32;
    const int64_t pitchY = fast ? C : ((dtype == 1) ? P16 : P32);
    const int64_t pitchX = fast ? dim : ((dtype == 1) ? P16 : P32);
    // P7：fast 同址编排 temp 数（fp16 4 / fp32 1），慢路径 6/2
    const int64_t nTemp = fast ? ((dtype == 1) ? 4 : 1) : ((dtype == 1) ? 6 : 2);

    int64_t rowsMax = W / H + 2;
    if (rowsMax < 1) {
        rowsMax = 1;
    }
    if (rowsMax > 512) {
        rowsMax = 512;
    }
    const int64_t fixedBytes = 5 * C * 4 + 2 * pitchC * 4 + 8192 +
        3 * ((rowsMax * 4 + 31) / 32 * 32);
    const int64_t inQBytesPerHs = fast ? 2 * dim * isize : 2 * 2 * pitchX * isize;
    const int64_t outQBytesPerHs = 2 * 2 * pitchY * isize;
    const int64_t tempBytesPerHs = nTemp * pitchF * 4;
    const int64_t perHs = inQBytesPerHs + outQBytesPerHs + tempBytesPerHs;

    int64_t hs = (perHs > 0) ? (budget - fixedBytes) / perHs : 1;
    if (hs < 1) {
        hs = 1;
    }
    int64_t hsCap = (H < rotary_emb_impl::MAX_HS) ? H : rotary_emb_impl::MAX_HS;
    if (hs > hsCap) {
        hs = hsCap;
    }
    const int64_t Mc = (C < 64) ? C : 64;  // fp32 向量 mask 宽度硬限 64

    // P4 RowGroup：fast 且 H<=32（单行 tile 的 rep=H 过短，指令延迟链主导）时，
    // tile 改为 Grp 行 x 单 head（rep=Grp），角度链按行组批处理。Grp 由 UB 预算反推，
    // <16 时收益不足回退单行形态（Grp=1）。
    int64_t Grp = 1;
    if (fast && H <= 32) {
        // per-G：角度链拼接（ang/k/t/red 16C + cos/sin 8pitchC）+ fp32 中间量
        // （fp16 4 份 16C / fp32 1 份 4C）+ in/out 双缓冲 4*dim*isize
        const int64_t perG = (dtype == 1)
            ? (32 * C + 8 * pitchC + 4 * dim * isize)
            : (20 * C + 8 * pitchC + 4 * dim * isize);
        const int64_t fixedRG = C * 4 + 8192 + 3 * ((rowsMax * 4 + 31) / 32 * 32);
        int64_t gUb = (perG > 0) ? (budget - fixedRG) / perG : 1;
        if (gUb < 1) {
            gUb = 1;
        }
        if (gUb > rotary_emb_impl::MAX_HS) {
            gUb = rotary_emb_impl::MAX_HS;
        }
        if (gUb >= 16) {
            Grp = gUb;
            hs = 1;
        }
    }
    // 注：模式 A 角度链批处理（G_A 行共享）已实测回退——deepseek fp32 +160% / fp16 +51%
    // （vec 虽降 26% 但 mte2 x6.5 / scalar x4.5：集中批处理打断 TQue 双缓冲三级流水，
    // 断流损失 > 指令节省），模式 A 恒 Grp=1 逐行角度链，负结果详见性能迭代记录。

    if (dtype == 1) {
        if (Grp > 1) {
            rotary_pos_emb_custom<half, true><<<blockNum, nullptr, stream>>>(x, positions, y, B, S, H, dim, W, hs, Mc, Grp, theta);
        } else {
            rotary_pos_emb_custom<half, false><<<blockNum, nullptr, stream>>>(x, positions, y, B, S, H, dim, W, hs, Mc, 1, theta);
        }
    } else {
        if (Grp > 1) {
            rotary_pos_emb_custom<float, true><<<blockNum, nullptr, stream>>>(x, positions, y, B, S, H, dim, W, hs, Mc, Grp, theta);
        } else {
            rotary_pos_emb_custom<float, false><<<blockNum, nullptr, stream>>>(x, positions, y, B, S, H, dim, W, hs, Mc, 1, theta);
        }
    }
}
