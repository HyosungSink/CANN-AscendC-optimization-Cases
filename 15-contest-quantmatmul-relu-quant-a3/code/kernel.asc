#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include <algorithm>

// Tensor arithmetic is entirely on the NPU; host code only manages launches.
namespace qmrq {
using namespace AscendC;
__global__ __aicore__ void HugeKKernel(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR x1Scale, GM_ADDR x2Scale,
    GM_ADDR y, GM_ADDR yScale, int64_t m, int64_t n, int64_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    const int64_t block = AscendC::GetBlockIdx();
    const int64_t blocks = AscendC::GetBlockNum();
    // Align block boundaries for both INT8 y and FP32 yScale cache lines.
    int64_t rowGroup = 16;
    while ((rowGroup * n) % 64 != 0) rowGroup += 16;
    const int64_t rowsPerBlock = ((m + blocks - 1) / blocks + rowGroup - 1) /
                                 rowGroup * rowGroup;
    const __gm__ int8_t* __restrict__ a = reinterpret_cast<const __gm__ int8_t*>(x1);
    const __gm__ int8_t* __restrict__ b = reinterpret_cast<const __gm__ int8_t*>(x2);
    const __gm__ float* __restrict__ aScale = reinterpret_cast<const __gm__ float*>(x1Scale);
    const __gm__ float* __restrict__ bScale = reinterpret_cast<const __gm__ float*>(x2Scale);
    __gm__ int8_t* __restrict__ out = reinterpret_cast<__gm__ int8_t*>(y);
    __gm__ float* __restrict__ outScale = reinterpret_cast<__gm__ float*>(yScale);

    // The local buffer covers all configured cases (N <= 512). For larger N,
    // the second pass recomputes the dot product without extra GM storage.
    float activation[512];
    const bool useLocalBuffer = n <= 512;

    for (int64_t row = block * rowsPerBlock;
         row < m && row < (block + 1) * rowsPerBlock; ++row) {
        const float lhsScale = aScale[row];
        const __gm__ int8_t* aRow = a + row * k;
        float rowMax = 0.0f;

        for (int64_t col = 0; col < n; ++col) {
            const __gm__ int8_t* bCol = b + col * k;
            int32_t acc0 = 0;
            int32_t acc1 = 0;
            int32_t acc2 = 0;
            int32_t acc3 = 0;
            int32_t acc4 = 0;
            int32_t acc5 = 0;
            int32_t acc6 = 0;
            int32_t acc7 = 0;
            int64_t inner = 0;
#pragma unroll 8
            for (; inner + 7 < k; inner += 8) {
                acc0 += static_cast<int32_t>(aRow[inner]) * static_cast<int32_t>(bCol[inner]);
                acc1 += static_cast<int32_t>(aRow[inner + 1]) * static_cast<int32_t>(bCol[inner + 1]);
                acc2 += static_cast<int32_t>(aRow[inner + 2]) * static_cast<int32_t>(bCol[inner + 2]);
                acc3 += static_cast<int32_t>(aRow[inner + 3]) * static_cast<int32_t>(bCol[inner + 3]);
                acc4 += static_cast<int32_t>(aRow[inner + 4]) * static_cast<int32_t>(bCol[inner + 4]);
                acc5 += static_cast<int32_t>(aRow[inner + 5]) * static_cast<int32_t>(bCol[inner + 5]);
                acc6 += static_cast<int32_t>(aRow[inner + 6]) * static_cast<int32_t>(bCol[inner + 6]);
                acc7 += static_cast<int32_t>(aRow[inner + 7]) * static_cast<int32_t>(bCol[inner + 7]);
            }
            for (; inner < k; ++inner) {
                acc0 += static_cast<int32_t>(aRow[inner]) * static_cast<int32_t>(bCol[inner]);
            }
            float value = static_cast<float>(acc0 + acc1 + acc2 + acc3 + acc4 + acc5 + acc6 + acc7) * lhsScale * bScale[col];
            if (value < 0.0f) value = 0.0f;
            if (useLocalBuffer) activation[col] = value;
            if (value > rowMax) rowMax = value;
        }

        const float scale = rowMax > 0.0f ? rowMax / 127.0f : 1.0f;
        outScale[row] = scale;
        for (int64_t col = 0; col < n; ++col) {
            float value;
            if (useLocalBuffer) {
                value = activation[col];
            } else {
                const __gm__ int8_t* bCol = b + col * k;
                int32_t acc0 = 0;
                int32_t acc1 = 0;
                int32_t acc2 = 0;
                int32_t acc3 = 0;
                int32_t acc4 = 0;
                int32_t acc5 = 0;
                int32_t acc6 = 0;
                int32_t acc7 = 0;
                int64_t inner = 0;
#pragma unroll 8
                for (; inner + 7 < k; inner += 8) {
                    acc0 += static_cast<int32_t>(aRow[inner]) * static_cast<int32_t>(bCol[inner]);
                    acc1 += static_cast<int32_t>(aRow[inner + 1]) * static_cast<int32_t>(bCol[inner + 1]);
                    acc2 += static_cast<int32_t>(aRow[inner + 2]) * static_cast<int32_t>(bCol[inner + 2]);
                    acc3 += static_cast<int32_t>(aRow[inner + 3]) * static_cast<int32_t>(bCol[inner + 3]);
                    acc4 += static_cast<int32_t>(aRow[inner + 4]) * static_cast<int32_t>(bCol[inner + 4]);
                    acc5 += static_cast<int32_t>(aRow[inner + 5]) * static_cast<int32_t>(bCol[inner + 5]);
                    acc6 += static_cast<int32_t>(aRow[inner + 6]) * static_cast<int32_t>(bCol[inner + 6]);
                    acc7 += static_cast<int32_t>(aRow[inner + 7]) * static_cast<int32_t>(bCol[inner + 7]);
                }
                for (; inner < k; ++inner) {
                    acc0 += static_cast<int32_t>(aRow[inner]) * static_cast<int32_t>(bCol[inner]);
                }
                value = static_cast<float>(acc0 + acc1 + acc2 + acc3 + acc4 + acc5 + acc6 + acc7) * lhsScale * bScale[col];
                if (value < 0.0f) value = 0.0f;
            }
            const float raw = value / scale;
            const int32_t integral = static_cast<int32_t>(raw);
            const float fraction = raw - static_cast<float>(integral);
            int32_t rounded = integral;
            if (fraction > 0.5f || (fraction == 0.5f && (integral & 1))) {
                ++rounded;
            }
            if (rounded < -128) rounded = -128;
            if (rounded > 127) rounded = 127;
            out[row * n + col] = static_cast<int8_t>(rounded);
        }
    }
}
constexpr uint32_t kChunk = 8192;

__global__ __aicore__ void PadInputsKernel(GM_ADDR a, GM_ADDR b,
        GM_ADDR paddedA, GM_ADDR paddedB, uint32_t m, uint32_t n,
        uint32_t k, uint32_t paddedK) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> temporary;
    constexpr uint32_t kPadBytes = 32768;
    pipe.InitBuffer(temporary, kPadBytes);
    auto local = temporary.Get<int8_t>();
    const uint32_t rowsPerCopy = kPadBytes / paddedK;
    const uint32_t core = GetBlockIdx();
    const uint32_t cores = GetBlockNum();
    for (uint32_t tensor = 0; tensor < 2; ++tensor) {
        GlobalTensor<int8_t> source, target;
        source.SetGlobalBuffer((__gm__ int8_t*)(tensor ? b : a));
        target.SetGlobalBuffer((__gm__ int8_t*)(tensor ? paddedB : paddedA));
        const uint32_t rows = tensor ? n : m;
        for (uint32_t row = core * rowsPerCopy; row < rows; row += cores * rowsPerCopy) {
            const uint32_t count = rows - row < rowsPerCopy ? rows - row : rowsPerCopy;
            DataCopyPad(local, source[(uint64_t)row * k],
                DataCopyExtParams{(uint16_t)count, k, 0, 0, 0},
                DataCopyPadExtParams<int8_t>{true, 0, (uint8_t)(paddedK - k), 0});
            SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
            DataCopy(target[(uint64_t)row * paddedK], local, count * paddedK);
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
    }
}


// The caller selects finite positive ratios near an INT8 half-integer.
// Divide normalized 24-bit significands exactly and round once to FP32.
__aicore__ inline uint32_t RoundedRatioBits(uint32_t numerator, uint32_t denominator) {
    uint32_t a = numerator & 0x7fffff;
    uint32_t b = denominator & 0x7fffff;
    int32_t ea = (numerator >> 23) & 0xff;
    int32_t eb = (denominator >> 23) & 0xff;
    if (ea) a |= 0x800000;
    else {
        ea = 1;
        while (a < 0x800000) { a <<= 1; --ea; }
    }
    if (eb) b |= 0x800000;
    else {
        eb = 1;
        while (b < 0x800000) { b <<= 1; --eb; }
    }
    const uint32_t shift = a < b ? 24 : 23;
    int32_t exponent = ea - eb - (a < b ? 1 : 0);
    const uint64_t dividend = (uint64_t)a << shift;
    uint32_t significand = dividend / b;
    const uint64_t remainder = dividend - (uint64_t)significand * b;
    if (remainder * 2 > b || (remainder * 2 == b && (significand & 1))) {
        ++significand;
    }
    if (significand == 0x1000000) { significand >>= 1; ++exponent; }
    return ((uint32_t)(exponent + 127) << 23) | (significand & 0x7fffff);
}

// Only ratios already detected within 2^-14 of j+0.5 reach this helper.
// Compare against the exact FP32 rounding midpoint needed by round-to-even
// quantization. This preserves FP32 division followed by integer RINT, without
// computing the full 24-bit quotient or issuing a 64-bit integer division.
__aicore__ inline uint32_t RoundedNearHalfBits(uint32_t numerator, uint32_t denominator,
                                             uint32_t approximate) {
    uint32_t a = numerator & 0x7fffff;
    uint32_t b = denominator & 0x7fffff;
    int32_t ea = (numerator >> 23) & 0xff;
    int32_t eb = (denominator >> 23) & 0xff;
    if (ea) a |= 0x800000;
    else {
        ea = 1;
        while (a < 0x800000) { a <<= 1; --ea; }
    }
    if (eb) b |= 0x800000;
    else {
        eb = 1;
        while (b < 0x800000) { b <<= 1; --eb; }
    }
    const uint32_t j = ((approximate & 0x7fffff) | 0x800000) >>
        (150 - ((approximate >> 23) & 0xff));
    const uint32_t odd = 2 * j + 1;
    const int32_t highest = 63 - CountLeadingZero(static_cast<uint64_t>(odd));
    const uint32_t midpointSignificand = odd << (23 - highest);
    const int32_t midpointExponent = highest - 1;
    // j+0.5 has an even FP32 significand. Equality at either surrounding
    // FP32 midpoint therefore rounds to j+0.5. Integer RINT then chooses
    // j for even j and j+1 for odd j, explaining > versus >= below.
    const uint32_t threshold = (j & 1) ? 2 * midpointSignificand - 1
                                       : 2 * midpointSignificand + 1;
    const uint64_t lhs = static_cast<uint64_t>(a) << (ea - eb - midpointExponent + 24);
    const uint64_t rhs = static_cast<uint64_t>(b) * threshold;
    const bool roundUp = (j & 1) ? lhs >= rhs : lhs > rhs;
    const uint32_t rounded = j + static_cast<uint32_t>(roundUp);
    if (rounded == 0) return 0;
    const uint32_t resultExponent = 63 - CountLeadingZero(static_cast<uint64_t>(rounded));
    return ((resultExponent + 127) << 23) | ((rounded << (23 - resultExponent)) & 0x7fffff);
}

template <const MatmulConfig& Config>
__aicore__ inline void CubePipeline(GM_ADDR a, GM_ADDR b, GM_ADDR c,
        TCubeTiling tiling, uint32_t m, uint32_t n, uint32_t k,
        uint32_t stride, uint32_t tileM, uint32_t tileN, uint32_t blocks) {
    TPipe pipe;
    using A = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using B = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, true>;
    using C = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    matmul::Matmul<A, B, C, C, Config> mm;
    mm.Init(&tiling, &pipe);
    GlobalTensor<int8_t> aGm, bGm;
    GlobalTensor<int32_t> cGm;
    aGm.SetGlobalBuffer((__gm__ int8_t*)a);
    bGm.SetGlobalBuffer((__gm__ int8_t*)b);
    cGm.SetGlobalBuffer((__gm__ int32_t*)c);
    const uint32_t block = GetBlockIdx();
    const uint32_t tasks = (m + tileM - 1) / tileM;
    mm.SetOrgShape(m, n, k, k, stride);
    uint32_t wave = 0;
    for (uint32_t task = block; task < tasks; task += blocks, ++wave) {
        const uint32_t slot = wave % 2;
        // Two slots let Cube produce the next row tile while Vector quantizes
        // the previous one. Both Vector subcores must release a reused slot.
        if (wave >= 2) CrossCoreWaitFlag<2>(slot + 2);
        const uint32_t row = task * tileM;
        const uint32_t workRow = (block * 2 + slot) * tileM;
        // Let Matmul traverse the N tiles internally and reuse its A buffers.
        mm.SetSingleShape(m - row < tileM ? m - row : tileM, n, k);
        mm.SetTensorA(aGm[(uint64_t)row * k]);
        mm.SetTensorB(bGm, true);
        mm.IterateAll(cGm[(uint64_t)workRow * stride]);
        mm.End();
        CrossCoreSetFlag<2, PIPE_FIX>(slot);
    }
    // Consume every notification, including the last two outstanding tiles.
    if (wave >= 1) CrossCoreWaitFlag<2>((wave - 1) % 2 + 2);
    if (wave >= 2) CrossCoreWaitFlag<2>((wave - 2) % 2 + 2);
}

class Epilogue {
public:
    __aicore__ inline void Init(GM_ADDR accum, GM_ADDR rowScale,
            GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
            uint32_t m, uint32_t n, uint32_t stride) {
        m_ = m; n_ = n; stride_ = stride;
        chunk_ = n < kChunk ? ((n + 63) / 64) * 64 : kChunk;
        accum_.SetGlobalBuffer((__gm__ int32_t*)accum);
        rowScale_.SetGlobalBuffer((__gm__ float*)rowScale);
        colScale_.SetGlobalBuffer((__gm__ float*)colScale);
        y_.SetGlobalBuffer((__gm__ int8_t*)y);
        yScale_.SetGlobalBuffer((__gm__ float*)yScale);
        batch_ = n >= 256 && n <= 4096 && n % 64 == 0 ? (kChunk / n < 8 ? kChunk / n : 8) : 1;
        const uint32_t capacity = chunk_ * batch_;
        pipe_.InitBuffer(in_, capacity * 4);
        pipe_.InitBuffer(fp_, capacity * 4);
        pipe_.InitBuffer(scale_, chunk_ * 4);
        pipe_.InitBuffer(half_, capacity * 2);
        pipe_.InitBuffer(out_, capacity * 1);
        pipe_.InitBuffer(reduce_, capacity * 4);
        pipe_.InitBuffer(scalar_, 320);
        if (n_ <= chunk_) {
            DataCopyPad(scale_.Get<float>(), colScale_,
                        DataCopyExtParams{1, n_ * 4, 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
        }
    }
    __aicore__ inline void Load(uint32_t row, uint32_t col, uint32_t count, float s) {
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        auto ints = in_.Get<int32_t>();
        auto fp = fp_.Get<float>();
        auto scales = scale_.Get<float>();
        DataCopyExtParams copy{1, count * 4, 0, 0, 0};
        DataCopyPad(ints, accum_[(uint64_t)row * stride_ + col], copy,
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        if (n_ > chunk_) {
            DataCopyPad(scales, colScale_[col], copy,
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(fp, ints, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Muls(fp, fp, s, count);
        PipeBarrier<PIPE_V>();
        Mul(fp, fp, scales, count);
        PipeBarrier<PIPE_V>();
        Maxs(fp, fp, 0.0f, count);
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline float Maximum(uint32_t count) {
        auto scalar = scalar_.Get<float>();
        ReduceMax(scalar, fp_.Get<float>(), reduce_.Get<float>(), count, false);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        return scalar.GetValue(0);
    }
    __aicore__ inline void Store(uint32_t row, uint32_t col, uint32_t count, float s) {
        auto fp = fp_.Get<float>();
        auto quotient = in_.Get<float>();
        auto residual = reduce_.Get<float>();
        auto halves = half_.Get<half>();
        auto out = out_.Get<int8_t>();
        Duplicate(residual, s, count);
        PipeBarrier<PIPE_V>();
        // A hardware division error can cross a half-integer boundary.
        // Detect those elements in parallel, then correct their FP32 quotient
        // with integer significand arithmetic on the device scalar unit.
        Div(quotient, fp, residual, count);
        PipeBarrier<PIPE_V>();
        Cast(residual, quotient, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Sub(residual, quotient, residual, count);
        PipeBarrier<PIPE_V>();
        Abs(residual, residual, count);
        PipeBarrier<PIPE_V>();
        // Compares processes complete 64-element repeats on this target.
        Compares(out_.Get<uint8_t>(), residual, 0.49993896484375f,
                 CMPMODE::GE, (count + 63) / 64 * 64);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        auto flags = out_.Get<uint64_t>();
        auto numerators = fp_.Get<uint32_t>();
        auto corrected = in_.Get<uint32_t>();
        const uint32_t divisor = scalar_.Get<uint32_t>().GetValue(0);
        for (uint32_t group = 0; group < (count + 63) / 64; ++group) {
            uint64_t bits = flags.GetValue(group);
            while (bits) {
                const uint32_t bit = 63 - CountLeadingZero(bits);
                const uint32_t index = group * 64 + bit;
                if (index < count) {
                    corrected.SetValue(index, RoundedNearHalfBits(numerators.GetValue(index), divisor, corrected.GetValue(index)));
                }
                bits &= ~(uint64_t(1) << bit);
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        // Round-to-odd preserves which side of every INT8 half-integer q
        // lies on; exact ties remain exact. The INT8 conversion saturates.
        Cast(halves, quotient, RoundMode::CAST_ODD, count);
        PipeBarrier<PIPE_V>();
        Cast(out, halves, RoundMode::CAST_RINT, count);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(y_[(uint64_t)row * n_ + col], out,
                    DataCopyExtParams{1, count, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    __aicore__ inline void StoreBatch(uint32_t row, uint32_t rows) {
        const uint32_t count = rows * n_;
        auto fp = fp_.Get<float>();
        auto quotient = in_.Get<float>();
        auto residual = reduce_.Get<float>();
        auto halves = half_.Get<half>();
        auto out = out_.Get<int8_t>();
        for (uint32_t r = 0; r < rows; ++r) {
            Duplicate(residual[r * n_], scalar_.Get<float>().GetValue(64 + r), n_);
        }
        PipeBarrier<PIPE_V>();
        // A hardware division error can cross a half-integer boundary.
        // Detect those elements in parallel, then correct their FP32 quotient
        // with integer significand arithmetic on the device scalar unit.
        Div(quotient, fp, residual, count);
        PipeBarrier<PIPE_V>();
        Cast(residual, quotient, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Sub(residual, quotient, residual, count);
        PipeBarrier<PIPE_V>();
        Abs(residual, residual, count);
        PipeBarrier<PIPE_V>();
        // Compares processes complete 64-element repeats on this target.
        Compares(out_.Get<uint8_t>(), residual, 0.49993896484375f,
                 CMPMODE::GE, (count + 63) / 64 * 64);
        PipeBarrier<PIPE_V>();
        const uint32_t flagGroups = (count + 63) / 64;
        const uint32_t maskWords = flagGroups * 4;
        const uint32_t firstRepeats = (maskWords + 63) / 64;
        const uint32_t pairGroups = (flagGroups + 1) / 2;
        // Each eight-word block identifies a pair of UINT64 element masks.
        // Up to 8192 outputs use 512 cast mask words and 64 pair summaries.
        // The disjoint scratch regions preserve the original element masks.
        Duplicate(residual, 0.0f, 576);
        PipeBarrier<PIPE_V>();
        Cast(residual, out_.Get<int16_t>(), RoundMode::CAST_NONE, maskWords);
        PipeBarrier<PIPE_V>();
        Abs(residual, residual, maskWords);
        PipeBarrier<PIPE_V>();
        // FP32 BlockReduceMax emits eight values/repeat; dst stride 1 is 32B.
        BlockReduceMax(residual[512], residual, firstRepeats, 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        Compares(scalar_.Get<uint8_t>()[288], residual[512], 0.0f,
                 CMPMODE::GT, (pairGroups + 63) / 64 * 64);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        auto flags = out_.Get<uint64_t>();
        auto numerators = fp_.Get<uint32_t>();
        auto corrected = in_.Get<uint32_t>();

        for (uint32_t word = 0; word < (pairGroups + 63) / 64; ++word) {
            uint64_t activePairs = scalar_.Get<uint64_t>().GetValue(36 + word);
            while (activePairs) {
                const uint32_t pairBit = 63 - CountLeadingZero(activePairs);
                const uint32_t pair = word * 64 + pairBit;
                for (uint32_t lane = 0; lane < 2; ++lane) {
                    const uint32_t group = pair * 2 + lane;
                    if (group >= flagGroups) break;
                    uint64_t bits = flags.GetValue(group);
                    while (bits) {
                        const uint32_t bit = 63 - CountLeadingZero(bits);
                        const uint32_t index = group * 64 + bit;
                        if (index < count) {
                            corrected.SetValue(index, RoundedNearHalfBits(numerators.GetValue(index), scalar_.Get<uint32_t>().GetValue(64 + index / n_), corrected.GetValue(index)));
                        }
                        bits &= ~(uint64_t(1) << bit);
                    }
                }
                activePairs &= ~(uint64_t(1) << pairBit);
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        // Round-to-odd preserves which side of every INT8 half-integer q
        // lies on; exact ties remain exact. The INT8 conversion saturates.
        Cast(halves, quotient, RoundMode::CAST_ODD, count);
        PipeBarrier<PIPE_V>();
        Cast(out, halves, RoundMode::CAST_RINT, count);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(y_[(uint64_t)row * n_], out,
                    DataCopyExtParams{1, count, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    __aicore__ inline void ProcessBatch(uint32_t row, uint32_t accRow, uint32_t rows) {
        const uint32_t count = rows * n_;
        auto fp = fp_.Get<float>();
        auto scalar = scalar_.Get<float>();
        auto residual = reduce_.Get<float>();
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopy(in_.Get<int32_t>(), accum_[(uint64_t)accRow * stride_], count);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(fp, in_.Get<int32_t>(), RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < rows; ++r) Muls(fp[r * n_], fp[r * n_], rowScale_.GetValue(row + r), n_);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < rows; ++r) Mul(fp[r * n_], fp[r * n_], scale_.Get<float>(), n_);
        PipeBarrier<PIPE_V>();
        Maxs(fp, fp, 0.0f, count);
        PipeBarrier<PIPE_V>();
        if (n_ >= 512 && n_ % 512 == 0) {
            WholeReduceMax(residual, fp, 64, count / 64, 1, 1, 8,
                           ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            WholeReduceMax(scalar, residual, n_ / 64, rows, 8, 1, n_ / 512,
                           ReduceOrder::ORDER_ONLY_VALUE);
        } else {
            for (uint32_t r = 0; r < rows; ++r) {
                ReduceMax(scalar[r * 8], fp[r * n_], residual, n_, false);
                PipeBarrier<PIPE_V>();
            }
        }
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        for (uint32_t r = 0; r < rows; ++r) {
            const float maximum = scalar.GetValue(r * 8);
            scalar.SetValue(64 + r, maximum > 0.0f ? maximum / 127.0f : 1.0f);
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopyPad(yScale_[row], scalar[64], DataCopyExtParams{1, rows * 4, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        StoreBatch(row, rows);
    }
    __aicore__ inline void ProcessRows(uint32_t firstRow, uint32_t rows,
            uint32_t workRow, uint32_t start, uint32_t step) {
        if (batch_ > 1 && rows > 2) {
            // Split the row tile before batching.  Starting at start*batch_
            // can leave the second Vector subcore empty when rows<=batch_.
            const uint32_t begin = static_cast<uint64_t>(rows) * start / step;
            const uint32_t end = static_cast<uint64_t>(rows) * (start + 1) / step;
            for (uint32_t r = begin; r < end; r += batch_) {
                ProcessBatch(firstRow + r, workRow + r,
                             end - r < batch_ ? end - r : batch_);
            }
            return;
        }
        for (uint32_t localRow = start; localRow < rows; localRow += step) {
            const uint32_t row = firstRow + localRow;
            const uint32_t accRow = workRow + localRow;
            const float s = rowScale_.GetValue(row);
            float maximum = 0.0f;
            for (uint32_t col = 0; col < n_; col += chunk_) {
                const uint32_t count = n_ - col < chunk_ ? n_ - col : chunk_;
                Load(accRow, col, count, s);
                const float v = Maximum(count);
                maximum = v > maximum ? v : maximum;
            }
            const float resultScale = maximum > 0.0f ? maximum / 127.0f : 1.0f;
            auto scalar = scalar_.Get<float>();
            scalar.SetValue(0, resultScale);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            DataCopyPad(yScale_[row], scalar, DataCopyExtParams{1, 4, 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            for (uint32_t col = 0; col < n_; col += chunk_) {
                const uint32_t count = n_ - col < chunk_ ? n_ - col : chunk_;
                if (n_ > chunk_) Load(accRow, col, count, s);
                Store(row, col, count, resultScale);
            }
        }
    }
private:
    TPipe pipe_;
    TBuf<TPosition::VECCALC> in_, fp_, scale_, half_, out_, reduce_, scalar_;
    GlobalTensor<int32_t> accum_;
    GlobalTensor<float> rowScale_, colScale_, yScale_;
    GlobalTensor<int8_t> y_;
    uint32_t m_, n_, stride_, chunk_, batch_;
};

class ColumnEpilogue {
public:
    __aicore__ inline void Init(GM_ADDR accum, GM_ADDR rowScale,
            GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
            uint32_t m, uint32_t n, uint32_t stride) {
        m_ = m; n_ = n; stride_ = stride;
        chunk_ = n < kChunk ? ((n + 63) / 64) * 64 : kChunk;
        accum_.SetGlobalBuffer((__gm__ int32_t*)accum);
        floatAccum_.SetGlobalBuffer((__gm__ float*)accum);
        rowScale_.SetGlobalBuffer((__gm__ float*)rowScale);
        colScale_.SetGlobalBuffer((__gm__ float*)colScale);
        y_.SetGlobalBuffer((__gm__ int8_t*)y);
        yScale_.SetGlobalBuffer((__gm__ float*)yScale);
        // The FP16 conversion reuses reduction scratch after scalar repair.
        // This permits 12288 values per batch within the 192 KiB UB budget.
        batch_ = n >= 1024 && n <= 4096 && n % 1024 == 0 ? 12288 / n :
            (n >= 256 && n <= 4096 && n % 64 == 0 ? (kChunk / n < 8 ? kChunk / n : 8) : 1);
        const uint32_t capacity = chunk_ * batch_;
        pipe_.InitBuffer(in_, capacity * 4);
        pipe_.InitBuffer(fp_, capacity * 4);
        pipe_.InitBuffer(scale_, chunk_ * 4);
        pipe_.InitBuffer(out_, capacity * 1);
        pipe_.InitBuffer(reduce_, capacity * 4);
        pipe_.InitBuffer(scalar_, 640);
        pipe_.InitBuffer(maximum_, 96 * 4);
        Duplicate(maximum_.Get<float>(), 0.0f, 96);
        if (n_ <= chunk_) {
            DataCopyPad(scale_.Get<float>(), colScale_,
                        DataCopyExtParams{1, n_ * 4, 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
        }
    }
    __aicore__ inline void StoreBatch(uint32_t row, uint32_t rows) {
        const uint32_t count = rows * n_;
        auto fp = fp_.Get<float>();
        auto quotient = in_.Get<float>();
        auto residual = reduce_.Get<float>();
        // residual is dead once the mask scan and exact scalar repair end.
        auto halves = reduce_.Get<half>();
        auto out = out_.Get<int8_t>();
        // A normal scalar reciprocal plus multiplication stays within the
        // exact correction window; extreme scales retain vector division.
        if (n_ == 4096) {
            for (uint32_t r = 0; r < rows; ++r) {
                const float divisor = scalar_.Get<float>().GetValue(64 + r);
                if (divisor >= 0x1p-120f && divisor <= 0x1p120f) {
                    Muls(quotient[r * n_], fp[r * n_], 1.0f / divisor, n_);
                } else {
                    Duplicate(residual[r * n_], divisor, n_);
                    PipeBarrier<PIPE_V>();
                    Div(quotient[r * n_], fp[r * n_], residual[r * n_], n_);
                }
            }
        } else {
            for (uint32_t r = 0; r < rows; ++r) {
                Duplicate(residual[r * n_], scalar_.Get<float>().GetValue(64 + r), n_);
            }
            PipeBarrier<PIPE_V>();
            Div(quotient, fp, residual, count);
        }
        PipeBarrier<PIPE_V>();
        // For q in [0,127], RN(q+1024) has ULP=2^-13. Its low 13
        // mantissa bits equal 0x1000 exactly at |q-(j+0.5)| <= 2^-14.
        // Shifting by 19 retains only these 13 bits; the target becomes
        // INT32_MIN. Integer EQ avoids interpreting other patterns as NaNs.
        Adds(residual, quotient, 1024.0f, count);
        PipeBarrier<PIPE_V>();
        auto magicBits = residual.ReinterpretCast<uint32_t>();
        ShiftLeft(magicBits, magicBits, static_cast<uint32_t>(19), count);
        PipeBarrier<PIPE_V>();
        // Compares processes complete 64-element repeats on this target.
        Compares(out_.Get<uint8_t>(), residual.ReinterpretCast<int32_t>(),
                 static_cast<int32_t>(-2147483647 - 1), CMPMODE::EQ, (count + 63) / 64 * 64);
        PipeBarrier<PIPE_V>();
        const uint32_t flagGroups = (count + 63) / 64;
        const uint32_t maskWords = flagGroups * 4;
        const uint32_t firstRepeats = (maskWords + 63) / 64;
        const uint32_t pairGroups = (flagGroups + 1) / 2;
        // Each eight-word block identifies a pair of UINT64 element masks.
        // The disjoint scratch regions preserve the original element masks.
        Duplicate(residual, 0.0f, 1152);
        PipeBarrier<PIPE_V>();
        Cast(residual, out_.Get<int16_t>(), RoundMode::CAST_NONE, maskWords);
        PipeBarrier<PIPE_V>();
        Abs(residual, residual, maskWords);
        PipeBarrier<PIPE_V>();
        // FP32 BlockReduceMax emits eight values/repeat; dst stride 1 is 32B.
        BlockReduceMax(residual[1024], residual, firstRepeats, 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        Compares(scalar_.Get<uint8_t>()[512], residual[1024], 0.0f,
                 CMPMODE::GT, (pairGroups + 63) / 64 * 64);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        auto flags = out_.Get<uint64_t>();
        auto numerators = fp_.Get<uint32_t>();
        auto corrected = in_.Get<uint32_t>();

        for (uint32_t word = 0; word < (pairGroups + 63) / 64; ++word) {
            uint64_t activePairs = scalar_.Get<uint64_t>().GetValue(64 + word);
            while (activePairs) {
                const uint32_t pairBit = 63 - CountLeadingZero(activePairs);
                const uint32_t pair = word * 64 + pairBit;
                for (uint32_t lane = 0; lane < 2; ++lane) {
                    const uint32_t group = pair * 2 + lane;
                    if (group >= flagGroups) break;
                    uint64_t bits = flags.GetValue(group);
                    while (bits) {
                        const uint32_t bit = 63 - CountLeadingZero(bits);
                        const uint32_t index = group * 64 + bit;
                        if (index < count) {
                            const uint32_t approximate = corrected.GetValue(index);
                            if ((approximate & 0x7f800000u) != 0x7f800000u) {
                                corrected.SetValue(index, RoundedNearHalfBits(numerators.GetValue(index), scalar_.Get<uint32_t>().GetValue(64 + index / n_), approximate));
                            }
                        }
                        bits &= ~(uint64_t(1) << bit);
                    }
                }
                activePairs &= ~(uint64_t(1) << pairBit);
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        // Round-to-odd preserves which side of every INT8 half-integer q
        // lies on; exact ties remain exact. The INT8 conversion saturates.
        Cast(halves, quotient, RoundMode::CAST_ODD, count);
        PipeBarrier<PIPE_V>();
        Cast(out, halves, RoundMode::CAST_RINT, count);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(y_[(uint64_t)row * n_], out,
                    DataCopyExtParams{1, count, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    __aicore__ inline void PrepareColumns(uint32_t firstRow, uint32_t rows,
            uint32_t workRow, uint32_t sub, uint32_t col, uint32_t width) {
        const uint32_t begin = rows * sub / 2;
        const uint32_t end = rows * (sub + 1) / 2;
        auto fp = fp_.Get<float>();
        auto scalar = scalar_.Get<float>();
        const uint32_t maxBatch = (chunk_ * batch_) / width < 16 ? (chunk_ * batch_) / width : 16;
        for (uint32_t r = begin; r < end; r += maxBatch) {
            const uint32_t batch = end - r < maxBatch ? end - r : maxBatch;
            const uint32_t count = batch * width;
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            DataCopyPad(in_.Get<int32_t>(), accum_[(uint64_t)(workRow + r) * stride_ + col],
                DataCopyExtParams{(uint16_t)batch, width * 4, (stride_ - width) * 4, 0, 0},
                DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(fp, in_.Get<int32_t>(), RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            for (uint32_t b = 0; b < batch; ++b) Muls(fp[b * width], fp[b * width], rowScale_.GetValue(firstRow + r + b), width);
            PipeBarrier<PIPE_V>();
            for (uint32_t b = 0; b < batch; ++b) Mul(fp[b * width], fp[b * width], scale_.Get<float>()[col], width);
            PipeBarrier<PIPE_V>();
            Maxs(fp, fp, 0.0f, count);
            PipeBarrier<PIPE_V>();
            if (width >= 512 && width % 512 == 0) {
                WholeReduceMax(reduce_.Get<float>(), fp, 64, count / 64, 1, 1, 8,
                               ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                WholeReduceMax(scalar, reduce_.Get<float>(), width / 64, batch, 8, 1, width / 512,
                               ReduceOrder::ORDER_ONLY_VALUE);
            } else {
                for (uint32_t b = 0; b < batch; ++b) {
                    ReduceMax(scalar[b * 8], fp[b * width], reduce_.Get<float>(), width, false);
                    PipeBarrier<PIPE_V>();
                }
            }
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t b = 0; b < batch; ++b) {
                const float current = scalar.GetValue(b * 8);
                const float previous = maximum_.Get<float>().GetValue(r + b);
                maximum_.Get<float>().SetValue(r + b, current > previous ? current : previous);
            }
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(floatAccum_[(uint64_t)(workRow + r) * stride_ + col], fp,
                DataCopyExtParams{(uint16_t)batch, width * 4, 0, (stride_ - width) * 4, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    __aicore__ inline void FinishColumns(uint32_t firstRow, uint32_t rows,
            uint32_t workRow, uint32_t sub) {
        const uint32_t begin = rows * sub / 2;
        const uint32_t end = rows * (sub + 1) / 2;
        auto scalar = scalar_.Get<float>();
        for (uint32_t r = begin; r < end; r += batch_) {
            const uint32_t count = end - r < batch_ ? end - r : batch_;
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            DataCopy(fp_.Get<float>(), floatAccum_[(uint64_t)(workRow + r) * stride_], count * n_);
            for (uint32_t b = 0; b < count; ++b) {
                const float maximum = maximum_.Get<float>().GetValue(r + b);
                scalar.SetValue(64 + b, maximum > 0.0f ? maximum / 127.0f : 1.0f);
            }
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            DataCopyPad(yScale_[firstRow + r], scalar[64], DataCopyExtParams{1, count * 4, 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            StoreBatch(firstRow + r, count);
        }
    }
private:
    TPipe pipe_;
    TBuf<TPosition::VECCALC> in_, fp_, scale_, out_, reduce_, scalar_;
    GlobalTensor<int32_t> accum_;
    GlobalTensor<float> rowScale_, colScale_, yScale_, floatAccum_;
    TBuf<TPosition::VECCALC> maximum_;
    GlobalTensor<int8_t> y_;
    uint32_t m_, n_, stride_, chunk_, batch_;
};

__global__ __aicore__ void ColumnStreamKernel(GM_ADDR a, GM_ADDR b, GM_ADDR accum,
        GM_ADDR rowScale, GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
        TCubeTiling tiling, uint32_t m, uint32_t n, uint32_t k,
        uint32_t stride, uint32_t tileM, uint32_t tileN, uint32_t blocks) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if ASCEND_IS_AIC {
        TPipe pipe;
        using A = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
        using B = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, true>;
        using C = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
        matmul::Matmul<A, B, C, C, CFG_MDL> mm;
        mm.Init(&tiling, &pipe);
        GlobalTensor<int8_t> aGm, bGm;
        GlobalTensor<int32_t> cGm;
        aGm.SetGlobalBuffer((__gm__ int8_t*)a);
        bGm.SetGlobalBuffer((__gm__ int8_t*)b);
        cGm.SetGlobalBuffer((__gm__ int32_t*)accum);
        const uint32_t row = GetBlockIdx() * tileM;
        const uint32_t workRow = GetBlockIdx() * 2 * tileM;
        const uint32_t tilesPerGroup = 512 / tiling.baseN;
        mm.SetOrgShape(m, n, k, k, stride);
        mm.SetSingleShape(m - row < tileM ? m - row : tileM, n, k);
        mm.SetTensorA(aGm[(uint64_t)row * k]);
        mm.SetTensorB(bGm, true);
        uint32_t count = 0, group = 0;
        while (mm.Iterate()) {
            mm.GetTensorC(cGm[(uint64_t)workRow * stride]);
            if (++count == tilesPerGroup) {
                CrossCoreSetFlag<2, PIPE_FIX>(group++);
                count = 0;
            }
        }
        // The final partial 512-column group also needs a notification.
        if (count != 0) CrossCoreSetFlag<2, PIPE_FIX>(group);
        mm.End();
        CrossCoreWaitFlag<2>(15);
    } else {
        ColumnEpilogue op;
        op.Init(accum, rowScale, colScale, y, yScale, m, n, stride);
        const uint32_t block = GetBlockIdx() / GetSubBlockNum();
        const uint32_t row = block * tileM;
        const uint32_t rows = m - row < tileM ? m - row : tileM;
        const uint32_t workRow = block * 2 * tileM;
        for (uint32_t group = 0; group * 512 < n; ++group) {
            CrossCoreWaitFlag<2>(group);
            const uint32_t col = group * 512;
            op.PrepareColumns(row, rows, workRow, GetSubBlockIdx(), col,
                              n - col < 512 ? n - col : 512);
        }
        op.FinishColumns(row, rows, workRow, GetSubBlockIdx());
        CrossCoreSetFlag<2, PIPE_MTE3>(15);
    }
}


// scale_ = column scales / divisor / tie distance / FP16; fp_ = FP32 / INT8.
class LongEpilogue {
public:
    __aicore__ inline void Init(GM_ADDR accum, GM_ADDR rowScale,
            GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
            uint32_t m, uint32_t n, uint32_t stride, bool streamColumns = false) {
        m_ = m; n_ = n; stride_ = stride;
        // Keep the complete dequantized row when sufficient UB remains for
        // useful vector chunks, avoiding all second-pass GM loads and scaling.
        rowCache_ = n <= 40960;
        const uint32_t rowCapacity = (n + 63) / 64 * 64;
        wholeStore_ = m >= 256 && n > 15872 && n <= 16448;
        if (wholeStore_) {
            // Two full FP32 rows (values and quotient), 15360-float scratch,
            // aligned full-row mask and scalar total at most 195232 bytes.
            chunk_ = 15360;
        } else if (rowCache_) {
            const uint32_t scratchBudget = 192 * 1024 - 1024 - rowCapacity * 4 - 128;
            const uint32_t scratchCapacity = scratchBudget / 2080 * 256;
            chunk_ = scratchCapacity < 15872 ? scratchCapacity : 15872;
            chunk_ = rowCapacity < chunk_ ? rowCapacity : chunk_;
        } else {
            chunk_ = n < 15872 ? rowCapacity : 15872;
        }
        accum_.SetGlobalBuffer((__gm__ int32_t*)accum);
        floatAccum_.SetGlobalBuffer((__gm__ float*)accum);
        rowScale_.SetGlobalBuffer((__gm__ float*)rowScale);
        colScale_.SetGlobalBuffer((__gm__ float*)colScale);
        y_.SetGlobalBuffer((__gm__ int8_t*)y);
        yScale_.SetGlobalBuffer((__gm__ float*)yScale);
        pipe_.InitBuffer(in_, (wholeStore_ ? rowCapacity : chunk_) * 4);
        pipe_.InitBuffer(fp_, (rowCache_ ? rowCapacity : chunk_) * 4);
        pipe_.InitBuffer(scale_, chunk_ * 4);
        pipe_.InitBuffer(mask_, wholeStore_ ? ((rowCapacity / 8 + 31) / 32) * 32 : chunk_ / 8);
        pipe_.InitBuffer(scalar_, 128);
        if (streamColumns) pipe_.InitBuffer(rowMaximum_, 32 * 4);
    }
    __aicore__ inline void Load(uint32_t row, uint32_t col, uint32_t count, float s,
            bool loadScales = true) {
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        auto ints = in_.Get<int32_t>();
        auto fp = fp_.Get<float>()[rowCache_ ? col : 0];
        auto scales = scale_.Get<float>();
        DataCopyExtParams copy{1, count * 4, 0, 0, 0};
        DataCopyPad(ints, accum_[(uint64_t)row * stride_ + col], copy,
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        if (loadScales) {
            DataCopyPad(scales, colScale_[col], copy,
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(fp, ints, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Muls(fp, fp, s, count);
        PipeBarrier<PIPE_V>();
        Mul(fp, fp, scales, count);
        PipeBarrier<PIPE_V>();
        Maxs(fp, fp, 0.0f, count);
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline float Maximum(uint32_t col, uint32_t count) {
        auto scalar = scalar_.Get<float>();
        ReduceMax(scalar, fp_.Get<float>()[rowCache_ ? col : 0], in_.Get<float>(), count, false);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        return scalar.GetValue(0);
    }
    __aicore__ inline void Store(uint32_t row, uint32_t col, uint32_t count, float s) {
        auto fp = fp_.Get<float>()[rowCache_ ? col : 0];
        auto quotient = in_.Get<float>();
        auto residual = scale_.Get<float>();
        auto halves = scale_.Get<half>();
        auto out = fp_.Get<int8_t>()[rowCache_ ? col * 4 : 0];
        if (count >= 8192 && s >= 0x1p-120f && s <= 0x1p120f) {
            Muls(quotient, fp, 1.0f / s, count);
        } else {
            Duplicate(residual, s, count);
            PipeBarrier<PIPE_V>();
            Div(quotient, fp, residual, count);
        }
        PipeBarrier<PIPE_V>();
        // For q in [0,127], RN(q+1024) has ULP=2^-13. Its low 13
        // mantissa bits equal 0x1000 exactly at |q-(j+0.5)| <= 2^-14.
        // Shifting by 19 retains only these 13 bits; the target becomes
        // INT32_MIN. Integer EQ avoids interpreting other patterns as NaNs.
        Adds(residual, quotient, 1024.0f, count);
        PipeBarrier<PIPE_V>();
        auto magicBits = residual.ReinterpretCast<uint32_t>();
        ShiftLeft(magicBits, magicBits, static_cast<uint32_t>(19), count);
        PipeBarrier<PIPE_V>();
        // Compares processes complete 64-element repeats on this target.
        Compares(mask_.Get<uint8_t>(), residual.ReinterpretCast<int32_t>(),
                 static_cast<int32_t>(-2147483647 - 1), CMPMODE::EQ, (count + 63) / 64 * 64);
        PipeBarrier<PIPE_V>();
        const uint32_t flagGroups = (count + 63) / 64;
        const uint32_t maskWords = flagGroups * 4;
        const uint32_t firstRepeats = (maskWords + 63) / 64;
        const uint32_t pairGroups = (flagGroups + 1) / 2;
        // Each eight-word block identifies a pair of UINT64 element masks.
        // The disjoint scratch regions preserve the original element masks.
        Duplicate(residual, 0.0f, 1152);
        PipeBarrier<PIPE_V>();
        Cast(residual, mask_.Get<int16_t>(), RoundMode::CAST_NONE, maskWords);
        PipeBarrier<PIPE_V>();
        Abs(residual, residual, maskWords);
        PipeBarrier<PIPE_V>();
        // FP32 BlockReduceMax emits eight values/repeat; dst stride 1 is 32B.
        BlockReduceMax(residual[1024], residual, firstRepeats, 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        Compares(scalar_.Get<uint8_t>()[32], residual[1024], 0.0f,
                 CMPMODE::GT, (pairGroups + 63) / 64 * 64);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        auto flags = mask_.Get<uint64_t>();
        auto numerators = fp_.Get<uint32_t>()[rowCache_ ? col : 0];
        auto corrected = in_.Get<uint32_t>();
        const uint32_t divisor = scalar_.Get<uint32_t>().GetValue(0);
        for (uint32_t word = 0; word < (pairGroups + 63) / 64; ++word) {
            uint64_t activePairs = scalar_.Get<uint64_t>().GetValue(4 + word);
            while (activePairs) {
                const uint32_t pairBit = 63 - CountLeadingZero(activePairs);
                const uint32_t pair = word * 64 + pairBit;
                for (uint32_t lane = 0; lane < 2; ++lane) {
                    const uint32_t group = pair * 2 + lane;
                    if (group >= flagGroups) break;
                    uint64_t bits = flags.GetValue(group);
                    while (bits) {
                        const uint32_t bit = 63 - CountLeadingZero(bits);
                        const uint32_t index = group * 64 + bit;
                        if (index < count) {
                            const uint32_t approximate = corrected.GetValue(index);
                            if ((approximate & 0x7f800000u) != 0x7f800000u) {
                                corrected.SetValue(index, RoundedNearHalfBits(numerators.GetValue(index), divisor, approximate));
                            }
                        }
                        bits &= ~(uint64_t(1) << bit);
                    }
                }
                activePairs &= ~(uint64_t(1) << pairBit);
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        // Odd rounding preserves the side of every INT8 half-integer.
        // The final RINT conversion implements ties-to-even and saturation.
        Cast(halves, quotient, RoundMode::CAST_ODD, count);
        PipeBarrier<PIPE_V>();
        Cast(out, halves, RoundMode::CAST_RINT, count);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(y_[(uint64_t)row * n_ + col], out,
                    DataCopyExtParams{1, count, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    __aicore__ inline void StoreWholeRow(uint32_t row, float s) {
        const uint32_t count = n_;
        auto fp = fp_.Get<float>();
        auto quotient = in_.Get<float>();
        auto residual = scale_.Get<float>();
        auto halves = scale_.Get<half>();
        auto out = fp_.Get<int8_t>();
        if (s >= 0x1p-120f && s <= 0x1p120f) {
            Muls(quotient, fp, 1.0f / s, count);
        } else {
            for (uint32_t col = 0; col < count; col += chunk_) {
                const uint32_t part = count - col < chunk_ ? count - col : chunk_;
                Duplicate(residual, s, part);
                PipeBarrier<PIPE_V>();
                Div(quotient[col], fp[col], residual, part);
                PipeBarrier<PIPE_V>();
            }
        }
        PipeBarrier<PIPE_V>();
        // Build one full-row mask using the smaller reusable scratch region.
        // chunk_ is 256-aligned, so both byte-mask destinations are 32B aligned.
        for (uint32_t col = 0; col < count; col += chunk_) {
            const uint32_t part = count - col < chunk_ ? count - col : chunk_;
            Adds(residual, quotient[col], 1024.0f, part);
            PipeBarrier<PIPE_V>();
            auto magicBits = residual.ReinterpretCast<uint32_t>();
            ShiftLeft(magicBits, magicBits, static_cast<uint32_t>(19), part);
            PipeBarrier<PIPE_V>();
            Compares(mask_.Get<uint8_t>()[col / 8], residual.ReinterpretCast<int32_t>(),
                     static_cast<int32_t>(-2147483647 - 1), CMPMODE::EQ, (part + 63) / 64 * 64);
            PipeBarrier<PIPE_V>();
        }
        const uint32_t flagGroups = (count + 63) / 64;
        const uint32_t maskWords = flagGroups * 4;
        const uint32_t firstRepeats = (maskWords + 63) / 64;
        const uint32_t pairGroups = (flagGroups + 1) / 2;
        // At most 257 UINT64 masks expand into 1028 floats. Keep the
        // 192-float padded pair summaries disjoint at offset 1152.
        Duplicate(residual, 0.0f, 1344);
        PipeBarrier<PIPE_V>();
        Cast(residual, mask_.Get<int16_t>(), RoundMode::CAST_NONE, maskWords);
        PipeBarrier<PIPE_V>();
        Abs(residual, residual, maskWords);
        PipeBarrier<PIPE_V>();
        // FP32 BlockReduceMax emits eight values/repeat; dst stride 1 is 32B.
        BlockReduceMax(residual[1152], residual, firstRepeats, 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        Compares(scalar_.Get<uint8_t>()[32], residual[1152], 0.0f,
                 CMPMODE::GT, (pairGroups + 63) / 64 * 64);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        auto flags = mask_.Get<uint64_t>();
        auto numerators = fp_.Get<uint32_t>();
        auto corrected = in_.Get<uint32_t>();
        const uint32_t divisor = scalar_.Get<uint32_t>().GetValue(0);
        for (uint32_t word = 0; word < (pairGroups + 63) / 64; ++word) {
            uint64_t activePairs = scalar_.Get<uint64_t>().GetValue(4 + word);
            while (activePairs) {
                const uint32_t pairBit = 63 - CountLeadingZero(activePairs);
                const uint32_t pair = word * 64 + pairBit;
                for (uint32_t lane = 0; lane < 2; ++lane) {
                    const uint32_t group = pair * 2 + lane;
                    if (group >= flagGroups) break;
                    uint64_t bits = flags.GetValue(group);
                    while (bits) {
                        const uint32_t bit = 63 - CountLeadingZero(bits);
                        const uint32_t index = group * 64 + bit;
                        if (index < count) {
                            const uint32_t approximate = corrected.GetValue(index);
                            if ((approximate & 0x7f800000u) != 0x7f800000u) {
                                corrected.SetValue(index, RoundedNearHalfBits(numerators.GetValue(index), divisor, approximate));
                            }
                        }
                        bits &= ~(uint64_t(1) << bit);
                    }
                }
                activePairs &= ~(uint64_t(1) << pairBit);
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        // Odd rounding preserves the side of every INT8 half-integer.
        // The final RINT conversion implements ties-to-even and saturation.
        Cast(halves, quotient, RoundMode::CAST_ODD, count);
        PipeBarrier<PIPE_V>();
        Cast(out, halves, RoundMode::CAST_RINT, count);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(y_[(uint64_t)row * n_], out,
                    DataCopyExtParams{1, count, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    // Consume each completed column group while Cube produces the next one.
    // FP32 values replace the consumed INT32 workspace; all K accumulation
    // for this group has completed before the producer's FIX notification.
    __aicore__ inline void PrepareColumns(uint32_t firstRow, uint32_t rows,
            uint32_t workRow, uint32_t sub, uint32_t col, uint32_t width) {
        if (sub >= rows) return;
        auto maxima = rowMaximum_.Get<float>();
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        // Maximum reuses in_ and scalar_; scale_ remains live for this group.
        DataCopyPad(scale_.Get<float>(), colScale_[col],
                    DataCopyExtParams{1, width * 4, 0, 0, 0},
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
        if (width == 4096) {
            auto fp = fp_.Get<float>();
            auto scratch = in_.Get<float>();
            auto scalar = scalar_.Get<float>();
            for (uint32_t r = sub; r < rows; r += 6) {
                const uint32_t remaining = (rows - r + 1) / 2;
                const uint32_t batch = remaining < 3 ? remaining : 3;
                const uint32_t count = batch * width;
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyPad(in_.Get<int32_t>(), accum_[(uint64_t)(workRow + r) * stride_ + col],
                            DataCopyExtParams{static_cast<uint16_t>(batch), width * 4,
                                              (2 * stride_ - width) * 4, 0, 0},
                            DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Cast(fp, in_.Get<int32_t>(), RoundMode::CAST_RINT, count);
                PipeBarrier<PIPE_V>();
                for (uint32_t lane = 0; lane < batch; ++lane) {
                    Muls(fp[lane * width], fp[lane * width],
                         rowScale_.GetValue(firstRow + r + lane * 2), width);
                }
                PipeBarrier<PIPE_V>();
                for (uint32_t lane = 0; lane < batch; ++lane) {
                    Mul(fp[lane * width], fp[lane * width], scale_.Get<float>(), width);
                }
                PipeBarrier<PIPE_V>();
                Maxs(fp, fp, 0.0f, count);
                PipeBarrier<PIPE_V>();
                // 3*4096 values produce at most 192 partial maxima in in_.
                WholeReduceMax(scratch, fp, 64, count / 64, 1, 1, 8,
                               ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                WholeReduceMax(scalar, scratch, width / 64, batch, 8, 1, width / 512,
                               ReduceOrder::ORDER_ONLY_VALUE);
                SetFlag<HardEvent::V_S>(EVENT_ID0);
                WaitFlag<HardEvent::V_S>(EVENT_ID0);
                for (uint32_t lane = 0; lane < batch; ++lane) {
                    const uint32_t localRow = r + lane * 2;
                    const float current = scalar.GetValue(lane * 8);
                    const float previous = col == 0 ? 0.0f : maxima.GetValue(localRow);
                    maxima.SetValue(localRow, current > previous ? current : previous);
                }
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyPad(floatAccum_[(uint64_t)(workRow + r) * stride_ + col], fp,
                            DataCopyExtParams{static_cast<uint16_t>(batch), width * 4,
                                              0, (2 * stride_ - width) * 4, 0});
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            return;
        }
        for (uint32_t r = sub; r < rows; r += 2) {
            const float rowScale = rowScale_.GetValue(firstRow + r);
            // Load's MTE2_V wait covers both this row and the group scales.
            Load(workRow + r, col, width, rowScale, false);
            const float current = Maximum(col, width);
            const float previous = col == 0 ? 0.0f : maxima.GetValue(r);
            maxima.SetValue(r, current > previous ? current : previous);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(floatAccum_[(uint64_t)(workRow + r) * stride_ + col],
                        fp_.Get<float>()[col],
                        DataCopyExtParams{1, width * 4, 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    __aicore__ inline void FinishColumns(uint32_t firstRow, uint32_t rows,
            uint32_t workRow, uint32_t sub) {
        auto scalar = scalar_.Get<float>();
        auto maxima = rowMaximum_.Get<float>();
        for (uint32_t r = sub; r < rows; r += 2) {
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            DataCopyPad(fp_.Get<float>(), floatAccum_[(uint64_t)(workRow + r) * stride_],
                        DataCopyExtParams{1, n_ * 4, 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
            const float maximum = maxima.GetValue(r);
            const float resultScale = maximum > 0.0f ? maximum / 127.0f : 1.0f;
            scalar.SetValue(0, resultScale);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            DataCopyPad(yScale_[firstRow + r], scalar, DataCopyExtParams{1, 4, 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            StoreWholeRow(firstRow + r, resultScale);
        }
    }
    __aicore__ inline void ProcessRows(uint32_t firstRow, uint32_t rows,
            uint32_t workRow, uint32_t start, uint32_t step) {
        for (uint32_t localRow = start; localRow < rows; localRow += step) {
            const uint32_t row = firstRow + localRow;
            const uint32_t accRow = workRow + localRow;
            const float s = rowScale_.GetValue(row);
            float maximum = 0.0f;
            for (uint32_t col = 0; col < n_; col += chunk_) {
                const uint32_t count = n_ - col < chunk_ ? n_ - col : chunk_;
                Load(accRow, col, count, s);
                const float v = Maximum(col, count);
                maximum = v > maximum ? v : maximum;
            }
            const float resultScale = maximum > 0.0f ? maximum / 127.0f : 1.0f;
            auto scalar = scalar_.Get<float>();
            scalar.SetValue(0, resultScale);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            DataCopyPad(yScale_[row], scalar, DataCopyExtParams{1, 4, 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            if (wholeStore_) {
                StoreWholeRow(row, resultScale);
            } else {
                for (uint32_t col = 0; col < n_; col += chunk_) {
                    const uint32_t count = n_ - col < chunk_ ? n_ - col : chunk_;
                    if (!rowCache_ && n_ > chunk_) Load(accRow, col, count, s);
                    Store(row, col, count, resultScale);
                }
            }
        }
    }
private:
    TPipe pipe_;
    TBuf<TPosition::VECCALC> in_, fp_, scale_, mask_, scalar_, rowMaximum_;
    GlobalTensor<int32_t> accum_;
    GlobalTensor<float> rowScale_, colScale_, yScale_, floatAccum_;
    GlobalTensor<int8_t> y_;
    uint32_t m_, n_, stride_, chunk_;
    bool rowCache_, wholeStore_;
};

// Small-K long rows keep the Cube tiling and overlap their first vector
// pass with 4096-column producer groups. At most five groups use flags 0..4.
__global__ __aicore__ void LongColumnStreamKernel(GM_ADDR a, GM_ADDR b, GM_ADDR accum,
        GM_ADDR rowScale, GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
        TCubeTiling tiling, uint32_t m, uint32_t n, uint32_t k,
        uint32_t stride, uint32_t tileM, uint32_t tileN, uint32_t blocks) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if ASCEND_IS_AIC {
        TPipe pipe;
        using A = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
        using B = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, true>;
        using C = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
        matmul::Matmul<A, B, C, C, CFG_MDL> mm;
        mm.Init(&tiling, &pipe);
        GlobalTensor<int8_t> aGm, bGm;
        GlobalTensor<int32_t> cGm;
        aGm.SetGlobalBuffer((__gm__ int8_t*)a);
        bGm.SetGlobalBuffer((__gm__ int8_t*)b);
        cGm.SetGlobalBuffer((__gm__ int32_t*)accum);
        const uint32_t row = GetBlockIdx() * tileM;
        const uint32_t workRow = GetBlockIdx() * 2 * tileM;
        const uint32_t tilesPerGroup = 4096 / tiling.baseN;
        mm.SetOrgShape(m, n, k, k, stride);
        mm.SetSingleShape(m - row < tileM ? m - row : tileM, n, k);
        mm.SetTensorA(aGm[(uint64_t)row * k]);
        mm.SetTensorB(bGm, true);
        uint32_t count = 0, group = 0;
        while (mm.Iterate()) {
            mm.GetTensorC(cGm[(uint64_t)workRow * stride]);
            if (++count == tilesPerGroup) {
                CrossCoreSetFlag<2, PIPE_FIX>(group++);
                count = 0;
            }
        }
        // A partial final group, including a one-column tail, is observable.
        if (count != 0) CrossCoreSetFlag<2, PIPE_FIX>(group);
        mm.End();
        CrossCoreWaitFlag<2>(8);
    } else {
        LongEpilogue op;
        op.Init(accum, rowScale, colScale, y, yScale, m, n, stride, true);
        const uint32_t block = GetBlockIdx() / GetSubBlockNum();
        const uint32_t row = block * tileM;
        const uint32_t rows = m - row < tileM ? m - row : tileM;
        const uint32_t workRow = block * 2 * tileM;
        for (uint32_t col = 0, group = 0; col < n; col += 4096, ++group) {
            CrossCoreWaitFlag<2>(group);
            const uint32_t width = n - col < 4096 ? n - col : 4096;
            op.PrepareColumns(row, rows, workRow, GetSubBlockIdx(), col, width);
        }
        op.FinishColumns(row, rows, workRow, GetSubBlockIdx());
        CrossCoreSetFlag<2, PIPE_MTE3>(8);
    }
}

template <bool LongRows> struct EpilogueSelector { using Type = Epilogue; };
template <> struct EpilogueSelector<true> { using Type = LongEpilogue; };

template <const MatmulConfig& Config, bool LongRows = false>
__global__ __aicore__ void FusedKernel(GM_ADDR a, GM_ADDR b, GM_ADDR accum,
        GM_ADDR rowScale, GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
        TCubeTiling tiling, uint32_t m, uint32_t n, uint32_t k,
        uint32_t stride, uint32_t tileM, uint32_t tileN, uint32_t blocks) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if ASCEND_IS_AIC {
        CubePipeline<Config>(a, b, accum, tiling, m, n, k, stride, tileM, tileN, blocks);
    } else {
        typename EpilogueSelector<LongRows>::Type op;
        op.Init(accum, rowScale, colScale, y, yScale, m, n, stride);
        const uint32_t block = GetBlockIdx() / GetSubBlockNum();
        const uint32_t tasks = (m + tileM - 1) / tileM;
        uint32_t wave = 0;
        for (uint32_t task = block; task < tasks; task += blocks, ++wave) {
            const uint32_t slot = wave % 2;
            const uint32_t row = task * tileM;
            CrossCoreWaitFlag<2>(slot);
            op.ProcessRows(row, m - row < tileM ? m - row : tileM,
                           (block * 2 + slot) * tileM, GetSubBlockIdx(), 2);
            CrossCoreSetFlag<2, PIPE_MTE3>(slot + 2);
        }
    }
}

// Short, wide matrices need column parallelism to use the available Cube cores.
// A device-side barrier makes all column tiles visible before row reductions.
template <bool LongRows>
__global__ __aicore__ void WideKernel(GM_ADDR a, GM_ADDR b, GM_ADDR accum,
        GM_ADDR rowScale, GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
        TCubeTiling tiling, uint32_t m, uint32_t n, uint32_t k,
        uint32_t stride, uint32_t tileM, uint32_t tileN, uint32_t blocks) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if ASCEND_IS_AIC {
        TPipe pipe;
        using A = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
        using B = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, true>;
        using C = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
        matmul::Matmul<A, B, C, C, CFG_MDL> mm;
        mm.Init(&tiling, &pipe);
        mm.SetOrgShape(m, n, k, k, stride);
        GlobalTensor<int8_t> aGm, bGm;
        GlobalTensor<int32_t> cGm;
        aGm.SetGlobalBuffer((__gm__ int8_t*)a);
        bGm.SetGlobalBuffer((__gm__ int8_t*)b);
        cGm.SetGlobalBuffer((__gm__ int32_t*)accum);
        const uint32_t nTiles = (n + tileN - 1) / tileN;
        const uint32_t tasks = ((m + tileM - 1) / tileM) * nTiles;
        for (uint32_t task = GetBlockIdx(); task < tasks; task += blocks) {
            const uint32_t row = (task / nTiles) * tileM;
            const uint32_t col = (task % nTiles) * tileN;
            mm.SetSingleShape(m - row < tileM ? m - row : tileM,
                              n - col < tileN ? n - col : tileN, k);
            mm.SetTensorA(aGm[(uint64_t)row * k]);
            mm.SetTensorB(bGm[(uint64_t)col * k], true);
            mm.IterateAll(cGm[(uint64_t)row * stride + col]);
            mm.End();
        }
        CrossCoreSetFlag<0, PIPE_FIX>(4);
        CrossCoreWaitFlag<0>(4);
        CrossCoreSetFlag<2, PIPE_FIX>(0);
    } else {
        typename EpilogueSelector<LongRows>::Type op;
        op.Init(accum, rowScale, colScale, y, yScale, m, n, stride);
        CrossCoreWaitFlag<2>(0);
        op.ProcessRows(0, m, 0, GetBlockIdx(), blocks * 2);
    }
}

// For K<=128, every INT8 product and partial FP32 sum is exact (<=2^21).
// One Vector core computes and quantizes one row without a GM accumulator.
template <uint32_t N, uint32_t K>
__global__ __aicore__ void SmallKernel(GM_ADDR a, GM_ADDR b,
        GM_ADDR rowScale, GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
        uint32_t m, uint32_t sourceK = K, uint32_t sourceN = N) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    static_assert(K % 32 == 0, "SmallKernel padded K");
    constexpr uint32_t matrixElements = N * K;
    constexpr uint32_t elements = matrixElements + K;
    constexpr uint32_t alignedN = (N + 63) / 64 * 64;
    TPipe pipe;
    TBuf<TPosition::VECCALC> inputs, halves, matrix, values, columns,
        quotient, residual, output, scalar;
    pipe.InitBuffer(inputs, elements);
    pipe.InitBuffer(halves, elements * 2);
    pipe.InitBuffer(matrix, elements * 4);
    pipe.InitBuffer(values, alignedN * 4);
    pipe.InitBuffer(columns, N * 4);
    pipe.InitBuffer(quotient, alignedN * 4);
    pipe.InitBuffer(residual, (K == 128 ? 2 : 1) * alignedN * 4);
    pipe.InitBuffer(output, alignedN);
    pipe.InitBuffer(scalar, 32);
    GlobalTensor<int8_t> aGm, bGm, yGm;
    GlobalTensor<float> rowGm, colGm, yScaleGm;
    aGm.SetGlobalBuffer((__gm__ int8_t*)a);
    bGm.SetGlobalBuffer((__gm__ int8_t*)b);
    rowGm.SetGlobalBuffer((__gm__ float*)rowScale);
    colGm.SetGlobalBuffer((__gm__ float*)colScale);
    yGm.SetGlobalBuffer((__gm__ int8_t*)y);
    yScaleGm.SetGlobalBuffer((__gm__ float*)yScale);
    auto ints = inputs.Get<int8_t>();
    auto halfs = halves.Get<half>();
    auto mat = matrix.Get<float>();
    auto fp = values.Get<float>();
    auto cols = columns.Get<float>();
    auto div = quotient.Get<float>();
    auto corrected = quotient.Get<uint32_t>();
    auto work = residual.Get<float>();
    auto out = output.Get<int8_t>();
    auto one = scalar.Get<float>();
    for (uint32_t row = GetBlockIdx(); row < m; row += GetBlockNum()) {
        if (row >= GetBlockNum()) {
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
        if (sourceK == K && sourceN == N) {
            DataCopy(ints, bGm, matrixElements);
            DataCopy(ints[matrixElements], aGm[(uint64_t)row * sourceK], K);
        } else {
            // Pad short K and N dimensions in UB.  Keeping N static lets the
            // vector repeat shape remain hardware-valid, while sourceN keeps
            // the GM read/write bounds exact for arbitrary tail columns.
            Duplicate(ints.ReinterpretCast<uint16_t>(), static_cast<uint16_t>(0),
                      matrixElements / 2);
            PipeBarrier<PIPE_V>();
            if (sourceK > 64 || sourceK < 16) {
                // C220 local padded DMA is not valid for every non-32-byte
                // row stride.  This tiny fallback uses scalar GM loads only
                // to stage the operands; the dot product remains vectorized.
                for (uint32_t r = 0; r < sourceN; ++r) {
                    for (uint32_t q = 0; q < sourceK; ++q) {
                        ints.SetValue(r * K + q,
                                      bGm.GetPhyAddr()[(uint64_t)r * sourceK + q]);
                    }
                }
            } else if (sourceN != N) {
                for (uint32_t r = 0; r < sourceN; ++r) {
                    DataCopyPad(ints[r * K], bGm[(uint64_t)r * sourceK],
                                DataCopyExtParams{1, sourceK, 0, 0, 0},
                                DataCopyPadExtParams<int8_t>{true, 0,
                                    (uint8_t)(K - sourceK), 0});
                }
            } else {
                DataCopyPad(ints, bGm,
                            DataCopyExtParams{(uint16_t)sourceN, sourceK, 0, 0, 0},
                            DataCopyPadExtParams<int8_t>{true, 0,
                                (uint8_t)(K - sourceK), 0});
            }
            if (sourceK > 64 || sourceK < 16) {
                for (uint32_t q = 0; q < sourceK; ++q) {
                    ints.SetValue(matrixElements + q,
                                  aGm.GetPhyAddr()[(uint64_t)row * sourceK + q]);
                }
            } else {
                DataCopyPad(ints[matrixElements], aGm[(uint64_t)row * sourceK],
                            DataCopyExtParams{1, sourceK, 0, 0, 0},
                            DataCopyPadExtParams<int8_t>{true, 0,
                                (uint8_t)(K - sourceK), 0});
            }
        }
        if (sourceN == N) {
            DataCopy(cols, colGm, N);
        } else {
            Duplicate(cols, 0.0f, N);
            DataCopyPad(cols, colGm,
                        DataCopyExtParams{1, sourceN * 4, 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(halfs, ints, RoundMode::CAST_NONE, elements);
        PipeBarrier<PIPE_V>();
        Cast(mat, halfs, RoundMode::CAST_NONE, elements);
        PipeBarrier<PIPE_V>();
        if constexpr (K == 128) {
            // FP32 vector masks cover at most 64 lanes. Each repeat still
            // advances one complete 128-element B row (16 data blocks).
            Mul(mat, mat, mat[matrixElements], 64, N,
                BinaryRepeatParams{1, 1, 1, K / 8, K / 8, 0});
            Mul(mat[64], mat[64], mat[matrixElements + 64], 64, N,
                BinaryRepeatParams{1, 1, 1, K / 8, K / 8, 0});
            PipeBarrier<PIPE_V>();
            WholeReduceSum(work, mat, 64, N, 1, 1, K / 8);
            WholeReduceSum(work[alignedN], mat[64], 64, N, 1, 1, K / 8);
            PipeBarrier<PIPE_V>();
            // Both 64-term sums and their total are exactly representable.
            Add(fp, work, work[alignedN], N);
            PipeBarrier<PIPE_V>();
        } else {
            Mul(mat, mat, mat[matrixElements], K, N, BinaryRepeatParams{1, 1, 1, K / 8, K / 8, 0});
            PipeBarrier<PIPE_V>();
            WholeReduceSum(fp, mat, K, N, 1, 1, K / 8);
            PipeBarrier<PIPE_V>();
        }
        Muls(fp, fp, rowGm.GetValue(row), N);
        PipeBarrier<PIPE_V>();
        Mul(fp, fp, cols, N);
        PipeBarrier<PIPE_V>();
        Maxs(fp, fp, 0.0f, N);
        PipeBarrier<PIPE_V>();
        ReduceMax(one, fp, work, N, false);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        const float maximum = one.GetValue(0);
        const float scale = maximum > 0.0f ? maximum / 127.0f : 1.0f;
        one.SetValue(0, scale);
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopyPad(yScaleGm[row], one, DataCopyExtParams{1, 4, 0, 0, 0});
        // In this normal range, reciprocal plus multiplication remains
        // within the existing 2^-14 exact half-integer correction window.
        if (scale >= 0x1p-120f && scale <= 0x1p120f) {
            Muls(div, fp, 1.0f / scale, N);
        } else {
            Duplicate(work, scale, N);
            PipeBarrier<PIPE_V>();
            Div(div, fp, work, N);
        }
        PipeBarrier<PIPE_V>();
        const uint32_t divisor = scalar.Get<uint32_t>().GetValue(0);
        if constexpr (N <= 16) {
            // For tiny rows, scanning a vector compare mask costs more than
            // checking the complete row in the scalar unit.  The quotient
            // was already produced by the vector divide; wait once, then use
            // the same exact significand test for every valid output.
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t index = 0; index < N; ++index) {
                const uint32_t approximate = quotient.Get<uint32_t>().GetValue(index);
                if ((approximate & 0x7f800000u) != 0 &&
                    (approximate & 0x7f800000u) != 0x7f800000u) {
                    corrected.SetValue(index,
                        RoundedNearHalfBits(values.Get<uint32_t>().GetValue(index),
                                            divisor, approximate));
                }
            }
        } else {
            // RN(q+1024) has ULP 2^-13 for these nonnegative INT8 ratios.
            // Its low 13 bits identify the closed 2^-14 half-integer window.
            Adds(work, div, 1024.0f, N);
            PipeBarrier<PIPE_V>();
            auto magicBits = work.ReinterpretCast<uint32_t>();
            ShiftLeft(magicBits, magicBits, static_cast<uint32_t>(19), N);
            PipeBarrier<PIPE_V>();
            Compares(output.Get<uint8_t>(), work.ReinterpretCast<int32_t>(),
                     static_cast<int32_t>(-2147483647 - 1), CMPMODE::EQ, alignedN);
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t group = 0; group < (N + 63) / 64; ++group) {
                uint64_t bits = output.Get<uint64_t>().GetValue(group);
                if (N < 64) bits &= (uint64_t(1) << (N % 64)) - 1;
                while (bits) {
                    const uint32_t bit = 63 - CountLeadingZero(bits);
                    const uint32_t index = group * 64 + bit;
                    const uint32_t approximate = quotient.Get<uint32_t>().GetValue(index);
                    if ((approximate & 0x7f800000u) != 0x7f800000u) {
                        corrected.SetValue(index,
                            RoundedNearHalfBits(values.Get<uint32_t>().GetValue(index), divisor, approximate));
                    }
                    bits &= ~(uint64_t(1) << bit);
                }
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        // Round-to-odd preserves INT8 ties; the final cast saturates.
        Cast(halfs, div, RoundMode::CAST_ODD, N);
        PipeBarrier<PIPE_V>();
        Cast(out, halfs, RoundMode::CAST_RINT, N);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(yGm[(uint64_t)row * sourceN], out,
                    DataCopyExtParams{1, sourceN, 0, 0, 0});
    }
}

// Two adjacent rows share one converted B panel. All K<=128 INT8 products
// and accumulated sums remain exact FP32 integers with magnitude <=2^21.
template <uint32_t N, uint32_t K>
__global__ __aicore__ void SmallBatch2Kernel(GM_ADDR a, GM_ADDR b,
        GM_ADDR rowScale, GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale,
        uint32_t m, uint32_t sourceK = K, uint32_t sourceN = N) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    static_assert(K == 32 || K == 64 || K == 128, "SmallBatch2Kernel K");
    constexpr uint32_t matrixElements = N * K;
    constexpr uint32_t elements = matrixElements + 2 * K;
    constexpr uint32_t alignedN = (N + 63) / 64 * 64;
    constexpr uint32_t capacity = 2 * alignedN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> inputs, halves, matrix, products, values, columns,
        quotient, residual, output, scalar;
    pipe.InitBuffer(inputs, elements);
    pipe.InitBuffer(halves, elements * 2);
    pipe.InitBuffer(matrix, elements * 4);
    pipe.InitBuffer(products, 2 * matrixElements * 4);
    pipe.InitBuffer(values, capacity * 4);
    pipe.InitBuffer(columns, N * 4);
    pipe.InitBuffer(quotient, capacity * 4);
    pipe.InitBuffer(residual, 2 * capacity * 4);
    pipe.InitBuffer(output, capacity);
    pipe.InitBuffer(scalar, 128);
    GlobalTensor<int8_t> aGm, bGm, yGm;
    GlobalTensor<float> rowGm, colGm, yScaleGm;
    aGm.SetGlobalBuffer((__gm__ int8_t*)a);
    bGm.SetGlobalBuffer((__gm__ int8_t*)b);
    rowGm.SetGlobalBuffer((__gm__ float*)rowScale);
    colGm.SetGlobalBuffer((__gm__ float*)colScale);
    yGm.SetGlobalBuffer((__gm__ int8_t*)y);
    yScaleGm.SetGlobalBuffer((__gm__ float*)yScale);
    auto ints = inputs.Get<int8_t>();
    auto halfs = halves.Get<half>();
    auto mat = matrix.Get<float>();
    auto product = products.Get<float>();
    auto fp = values.Get<float>();
    auto cols = columns.Get<float>();
    auto div = quotient.Get<float>();
    auto corrected = quotient.Get<uint32_t>();
    auto work = residual.Get<float>();
    auto out = output.Get<int8_t>();
    auto stats = scalar.Get<float>();
    if (sourceK != K || sourceN != N) {
        Duplicate(ints.ReinterpretCast<uint16_t>(), static_cast<uint16_t>(0),
                  elements / 2);
        PipeBarrier<PIPE_V>();
    }
    if (sourceK == K && sourceN == N) {
        DataCopy(ints, bGm, matrixElements);
    } else if (sourceK > 64 || sourceK < 16) {
        for (uint32_t r = 0; r < sourceN; ++r) {
            for (uint32_t q = 0; q < sourceK; ++q) {
                ints.SetValue(r * K + q,
                              bGm.GetPhyAddr()[(uint64_t)r * sourceK + q]);
            }
        }
    } else if (sourceN != N) {
        for (uint32_t r = 0; r < sourceN; ++r) {
            DataCopyPad(ints[r * K], bGm[(uint64_t)r * sourceK],
                        DataCopyExtParams{1, sourceK, 0, 0, 0},
                        DataCopyPadExtParams<int8_t>{true, 0,
                            (uint8_t)(K - sourceK), 0});
        }
    } else {
        DataCopyPad(ints, bGm,
                    DataCopyExtParams{(uint16_t)sourceN, sourceK, 0, 0, 0},
                    DataCopyPadExtParams<int8_t>{true, 0,
                        (uint8_t)(K - sourceK), 0});
    }
    if (sourceN == N) {
        DataCopy(cols, colGm, N);
    } else {
        Duplicate(cols, 0.0f, N);
        DataCopyPad(cols, colGm,
                    DataCopyExtParams{1, sourceN * 4, 0, 0, 0},
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
    }
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    Cast(halfs, ints, RoundMode::CAST_NONE, matrixElements);
    PipeBarrier<PIPE_V>();
    Cast(mat, halfs, RoundMode::CAST_NONE, matrixElements);
    PipeBarrier<PIPE_V>();
    const uint32_t pairs = (m + 1) / 2;
    for (uint32_t pair = GetBlockIdx(); pair < pairs; pair += GetBlockNum()) {
        if (pair >= GetBlockNum()) {
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
        const uint32_t row = pair * 2;
        const uint32_t rows = m - row < 2 ? m - row : 2;
        const uint32_t count = rows * N;
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        if (sourceK == K) {
            DataCopy(ints[matrixElements], aGm[(uint64_t)row * sourceK], rows * K);
        } else if (sourceK > 64 || sourceK < 16) {
            for (uint32_t r = 0; r < rows; ++r) {
                for (uint32_t q = 0; q < sourceK; ++q) {
                    ints.SetValue(matrixElements + r * K + q,
                                  aGm.GetPhyAddr()[(uint64_t)(row + r) * sourceK + q]);
                }
            }
        } else {
            DataCopyPad(ints[matrixElements], aGm[(uint64_t)row * sourceK],
                        DataCopyExtParams{(uint16_t)rows, sourceK, 0, 0, 0},
                        DataCopyPadExtParams<int8_t>{true, 0,
                            (uint8_t)(K - sourceK), 0});
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(halfs[matrixElements], ints[matrixElements], RoundMode::CAST_NONE, rows * K);
        PipeBarrier<PIPE_V>();
        Cast(mat[matrixElements], halfs[matrixElements], RoundMode::CAST_NONE, rows * K);
        PipeBarrier<PIPE_V>();
        if constexpr (K == 128) {
            for (uint32_t lane = 0; lane < rows; ++lane) {
                Mul(product[lane * matrixElements], mat, mat[matrixElements + lane * K],
                    64, N, BinaryRepeatParams{1, 1, 1, K / 8, K / 8, 0});
                Mul(product[lane * matrixElements + 64], mat[64], mat[matrixElements + lane * K + 64],
                    64, N, BinaryRepeatParams{1, 1, 1, K / 8, K / 8, 0});
            }
            PipeBarrier<PIPE_V>();
            WholeReduceSum(work, product, 64, count, 1, 1, K / 8);
            WholeReduceSum(work[capacity], product[64], 64, count, 1, 1, K / 8);
            PipeBarrier<PIPE_V>();
            Add(fp, work, work[capacity], count);
            PipeBarrier<PIPE_V>();
        } else {
            for (uint32_t lane = 0; lane < rows; ++lane) {
                Mul(product[lane * matrixElements], mat, mat[matrixElements + lane * K],
                    K, N, BinaryRepeatParams{1, 1, 1, K / 8, K / 8, 0});
            }
            PipeBarrier<PIPE_V>();
            WholeReduceSum(fp, product, K, count, 1, 1, K / 8);
            PipeBarrier<PIPE_V>();
        }
        for (uint32_t lane = 0; lane < rows; ++lane) {
            Muls(fp[lane * N], fp[lane * N], rowGm.GetValue(row + lane), N);
        }
        PipeBarrier<PIPE_V>();
        for (uint32_t lane = 0; lane < rows; ++lane) {
            Mul(fp[lane * N], fp[lane * N], cols, N);
        }
        PipeBarrier<PIPE_V>();
        Maxs(fp, fp, 0.0f, count);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(stats, fp, N, rows, 8, 1, N / 8,
                       ReduceOrder::ORDER_ONLY_VALUE);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        for (uint32_t lane = 0; lane < rows; ++lane) {
            const float maximum = stats.GetValue(lane * 8);
            stats.SetValue(16 + lane, maximum > 0.0f ? maximum / 127.0f : 1.0f);
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopyPad(yScaleGm[row], stats[16], DataCopyExtParams{1, rows * 4, 0, 0, 0});
        for (uint32_t lane = 0; lane < rows; ++lane) {
            const float scale = stats.GetValue(16 + lane);
            if (scale >= 0x1p-120f && scale <= 0x1p120f) {
                Muls(div[lane * N], fp[lane * N], 1.0f / scale, N);
            } else {
                Duplicate(work[lane * N], scale, N);
                PipeBarrier<PIPE_V>();
                Div(div[lane * N], fp[lane * N], work[lane * N], N);
            }
        }
        PipeBarrier<PIPE_V>();
        if constexpr (N <= 16) {
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t index = 0; index < count; ++index) {
                const uint32_t approximate = quotient.Get<uint32_t>().GetValue(index);
                if ((approximate & 0x7f800000u) != 0 &&
                    (approximate & 0x7f800000u) != 0x7f800000u) {
                    corrected.SetValue(index,
                        RoundedNearHalfBits(values.Get<uint32_t>().GetValue(index),
                            scalar.Get<uint32_t>().GetValue(16 + index / N), approximate));
                }
            }
        } else {
            Adds(work, div, 1024.0f, count);
            PipeBarrier<PIPE_V>();
            auto magicBits = work.ReinterpretCast<uint32_t>();
            ShiftLeft(magicBits, magicBits, static_cast<uint32_t>(19), count);
            PipeBarrier<PIPE_V>();
            Compares(output.Get<uint8_t>(), work.ReinterpretCast<int32_t>(),
                     static_cast<int32_t>(-2147483647 - 1), CMPMODE::EQ, (count + 63) / 64 * 64);
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t group = 0; group < (count + 63) / 64; ++group) {
                uint64_t bits = output.Get<uint64_t>().GetValue(group);
                while (bits) {
                    const uint32_t bit = 63 - CountLeadingZero(bits);
                    const uint32_t index = group * 64 + bit;
                    if (index < count) {
                        const uint32_t approximate = quotient.Get<uint32_t>().GetValue(index);
                        if ((approximate & 0x7f800000u) != 0x7f800000u) {
                            corrected.SetValue(index,
                                RoundedNearHalfBits(values.Get<uint32_t>().GetValue(index),
                                    scalar.Get<uint32_t>().GetValue(16 + index / N), approximate));
                        }
                    }
                    bits &= ~(uint64_t(1) << bit);
                }
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        Cast(halfs, div, RoundMode::CAST_ODD, count);
        PipeBarrier<PIPE_V>();
        Cast(out, halfs, RoundMode::CAST_RINT, count);
        if (sourceN == N) {
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(yGm[(uint64_t)row * N], out,
                        DataCopyExtParams{1, count, 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        } else {
            for (uint32_t r = 0; r < rows; ++r) {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyPad(yGm[(uint64_t)(row + r) * sourceN], out[r * N],
                            DataCopyExtParams{1, sourceN, 0, 0, 0});
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
    }
}

// Three adjacent rows share one converted B panel. All K128 INT8 products
// and accumulated sums remain exact FP32 integers with magnitude <=2^21.
template <uint32_t N>
__global__ __aicore__ void SmallK128Batch3Kernel(GM_ADDR a, GM_ADDR b,
        GM_ADDR rowScale, GM_ADDR colScale, GM_ADDR y, GM_ADDR yScale, uint32_t m) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr uint32_t K = 128;
    constexpr uint32_t matrixElements = N * K;
    constexpr uint32_t elements = matrixElements + 3 * K;
    constexpr uint32_t alignedN = (N + 63) / 64 * 64;
    constexpr uint32_t capacity = 3 * alignedN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> inputs, halves, matrix, products, values, columns,
        quotient, residual, output, scalar;
    pipe.InitBuffer(inputs, elements);
    pipe.InitBuffer(halves, elements * 2);
    pipe.InitBuffer(matrix, elements * 4);
    pipe.InitBuffer(products, 3 * matrixElements * 4);
    pipe.InitBuffer(values, capacity * 4);
    pipe.InitBuffer(columns, N * 4);
    pipe.InitBuffer(quotient, capacity * 4);
    pipe.InitBuffer(residual, 2 * capacity * 4);
    pipe.InitBuffer(output, capacity);
    pipe.InitBuffer(scalar, 160);
    GlobalTensor<int8_t> aGm, bGm, yGm;
    GlobalTensor<float> rowGm, colGm, yScaleGm;
    aGm.SetGlobalBuffer((__gm__ int8_t*)a);
    bGm.SetGlobalBuffer((__gm__ int8_t*)b);
    rowGm.SetGlobalBuffer((__gm__ float*)rowScale);
    colGm.SetGlobalBuffer((__gm__ float*)colScale);
    yGm.SetGlobalBuffer((__gm__ int8_t*)y);
    yScaleGm.SetGlobalBuffer((__gm__ float*)yScale);
    auto ints = inputs.Get<int8_t>();
    auto halfs = halves.Get<half>();
    auto mat = matrix.Get<float>();
    auto product = products.Get<float>();
    auto fp = values.Get<float>();
    auto cols = columns.Get<float>();
    auto div = quotient.Get<float>();
    auto corrected = quotient.Get<uint32_t>();
    auto work = residual.Get<float>();
    auto out = output.Get<int8_t>();
    auto stats = scalar.Get<float>();
    DataCopy(ints, bGm, matrixElements);
    DataCopy(cols, colGm, N);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    Cast(halfs, ints, RoundMode::CAST_NONE, matrixElements);
    PipeBarrier<PIPE_V>();
    Cast(mat, halfs, RoundMode::CAST_NONE, matrixElements);
    PipeBarrier<PIPE_V>();
    const uint32_t pairs = (m + 2) / 3;
    for (uint32_t pair = GetBlockIdx(); pair < pairs; pair += GetBlockNum()) {
        if (pair >= GetBlockNum()) {
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
        const uint32_t row = pair * 3;
        const uint32_t rows = m - row < 3 ? m - row : 3;
        const uint32_t count = rows * N;
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopy(ints[matrixElements], aGm[(uint64_t)row * K], rows * K);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(halfs[matrixElements], ints[matrixElements], RoundMode::CAST_NONE, rows * K);
        PipeBarrier<PIPE_V>();
        Cast(mat[matrixElements], halfs[matrixElements], RoundMode::CAST_NONE, rows * K);
        PipeBarrier<PIPE_V>();
        for (uint32_t lane = 0; lane < rows; ++lane) {
            Mul(product[lane * matrixElements], mat, mat[matrixElements + lane * K],
                64, N, BinaryRepeatParams{1, 1, 1, K / 8, K / 8, 0});
            Mul(product[lane * matrixElements + 64], mat[64], mat[matrixElements + lane * K + 64],
                64, N, BinaryRepeatParams{1, 1, 1, K / 8, K / 8, 0});
        }
        PipeBarrier<PIPE_V>();
        WholeReduceSum(work, product, 64, count, 1, 1, K / 8);
        WholeReduceSum(work[capacity], product[64], 64, count, 1, 1, K / 8);
        PipeBarrier<PIPE_V>();
        Add(fp, work, work[capacity], count);
        PipeBarrier<PIPE_V>();
        for (uint32_t lane = 0; lane < rows; ++lane) {
            Muls(fp[lane * N], fp[lane * N], rowGm.GetValue(row + lane), N);
        }
        PipeBarrier<PIPE_V>();
        for (uint32_t lane = 0; lane < rows; ++lane) {
            Mul(fp[lane * N], fp[lane * N], cols, N);
        }
        PipeBarrier<PIPE_V>();
        Maxs(fp, fp, 0.0f, count);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(stats, fp, N, rows, 8, 1, N / 8,
                       ReduceOrder::ORDER_ONLY_VALUE);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        for (uint32_t lane = 0; lane < rows; ++lane) {
            const float maximum = stats.GetValue(lane * 8);
            stats.SetValue(24 + lane, maximum > 0.0f ? maximum / 127.0f : 1.0f);
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopyPad(yScaleGm[row], stats[24], DataCopyExtParams{1, rows * 4, 0, 0, 0});
        for (uint32_t lane = 0; lane < rows; ++lane) {
            const float scale = stats.GetValue(24 + lane);
            if (scale >= 0x1p-120f && scale <= 0x1p120f) {
                Muls(div[lane * N], fp[lane * N], 1.0f / scale, N);
            } else {
                Duplicate(work[lane * N], scale, N);
                PipeBarrier<PIPE_V>();
                Div(div[lane * N], fp[lane * N], work[lane * N], N);
            }
        }
        PipeBarrier<PIPE_V>();
        if constexpr (N <= 16) {
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t index = 0; index < count; ++index) {
                const uint32_t approximate = quotient.Get<uint32_t>().GetValue(index);
                if ((approximate & 0x7f800000u) != 0 &&
                    (approximate & 0x7f800000u) != 0x7f800000u) {
                    corrected.SetValue(index,
                        RoundedNearHalfBits(values.Get<uint32_t>().GetValue(index),
                            scalar.Get<uint32_t>().GetValue(24 + index / N), approximate));
                }
            }
        } else {
            Adds(work, div, 1024.0f, count);
            PipeBarrier<PIPE_V>();
            auto magicBits = work.ReinterpretCast<uint32_t>();
            ShiftLeft(magicBits, magicBits, static_cast<uint32_t>(19), count);
            PipeBarrier<PIPE_V>();
            Compares(output.Get<uint8_t>(), work.ReinterpretCast<int32_t>(),
                     static_cast<int32_t>(-2147483647 - 1), CMPMODE::EQ, (count + 63) / 64 * 64);
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t group = 0; group < (count + 63) / 64; ++group) {
                uint64_t bits = output.Get<uint64_t>().GetValue(group);
                while (bits) {
                    const uint32_t bit = 63 - CountLeadingZero(bits);
                    const uint32_t index = group * 64 + bit;
                    if (index < count) {
                        const uint32_t approximate = quotient.Get<uint32_t>().GetValue(index);
                        if ((approximate & 0x7f800000u) != 0x7f800000u) {
                            corrected.SetValue(index,
                                RoundedNearHalfBits(values.Get<uint32_t>().GetValue(index),
                                    scalar.Get<uint32_t>().GetValue(24 + index / N), approximate));
                        }
                    }
                    bits &= ~(uint64_t(1) << bit);
                }
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        Cast(halfs, div, RoundMode::CAST_ODD, count);
        PipeBarrier<PIPE_V>();
        Cast(out, halfs, RoundMode::CAST_RINT, count);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(yGm[(uint64_t)row * N], out, DataCopyExtParams{1, count, 0, 0, 0});
    }
}

} // namespace qmrq

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR x1Scale, const TensorGroupInfo& info_x1Scale,
    GM_ADDR x2Scale, const TensorGroupInfo& info_x2Scale,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR yScale, const TensorGroupInfo& info_yScale,
    int64_t availableCoreNum, aclrtStream stream) {
    using namespace AscendC;
    const uint32_t m = info_x1.tensors[0].shape[0];
    const uint32_t sourceK = info_x1.tensors[0].shape[1];
    const uint32_t n = info_x2.tensors[0].shape[0];
    const bool padK = n >= 16384 && sourceK <= 256 && sourceK % 32 != 0;
    const uint32_t k = padK ? (sourceK + 31) / 32 * 32 : sourceK;
    if (sourceK > 65535) {
        const uint32_t hugeBlocks = std::min<uint32_t>(m, availableCoreNum > 0 ? availableCoreNum : 1);
        qmrq::HugeKKernel<<<hugeBlocks, nullptr, stream>>>(
            x1, x2, x1Scale, x2Scale, y, yScale, m, n, sourceK);
        return;
    }
    // The scalar fallback has a large fixed cost even when the dot product is
    // only a few dozen terms.  SmallKernel already has the exact FP32
    // accumulation and quantization path for K divisible by eight; dispatch
    // the small-N cases here before falling back to the generic scalar kernel.
    // Keep the template N equal to the real N so no adjacent B row is read.
    if ((m <= 128 && n <= 16 && sourceK <= 16) ||
        (m <= 32 && n <= 128 && sourceK <= 16)) {
        if (m <= 48 && (n == 8 || n == 16)) {
            const uint32_t pairBlocks = std::min<uint32_t>((m + 1) / 2,
                                                           availableCoreNum * 2);
            if (n == 8) qmrq::SmallBatch2Kernel<8, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK);
            else qmrq::SmallBatch2Kernel<16, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK);
            return;
        }
        const uint32_t smallKBlocks = std::min<uint32_t>(m, availableCoreNum * 2);
        if (n <= 8) {
            qmrq::SmallKernel<8, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n == 8) {
            qmrq::SmallKernel<8, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK);
        } else if (n == 16) {
            qmrq::SmallKernel<16, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK);
        } else if (n < 16) {
            qmrq::SmallKernel<16, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 32) {
            qmrq::SmallKernel<32, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 64) {
            qmrq::SmallKernel<64, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 128) {
            qmrq::SmallKernel<128, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else {
            return;
        }
        return;
    }
    if (m <= 32 && n <= 128 && sourceK > 64 && sourceK < 128) {
        const uint32_t smallKBlocks = std::min<uint32_t>(m, availableCoreNum * 2);
        if (n <= 8) {
            qmrq::SmallKernel<8, 128><<<smallKBlocks, nullptr, stream>>>(
                x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 16) {
            qmrq::SmallKernel<16, 128><<<smallKBlocks, nullptr, stream>>>(
                x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 32) {
            qmrq::SmallKernel<32, 128><<<smallKBlocks, nullptr, stream>>>(
                x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 64) {
            qmrq::SmallKernel<64, 128><<<smallKBlocks, nullptr, stream>>>(
                x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else {
            qmrq::SmallKernel<128, 128><<<smallKBlocks, nullptr, stream>>>(
                x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        }
        return;
    }
    if (m <= 96 && (n == 16 || n == 32 || n == 64) &&
        sourceK > 16 && sourceK <= 64) {
        const uint32_t pairBlocks = std::min<uint32_t>((m + 1) / 2,
                                                       availableCoreNum * 2);
        const uint32_t vecK = sourceK <= 32 ? 32 : 64;
        const uint32_t physicalN = n <= 16 ? 16 : (n <= 32 ? 32 : (n <= 64 ? 64 : 128));
        if (physicalN == 16) {
            if (vecK == 32) qmrq::SmallBatch2Kernel<16, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallBatch2Kernel<16, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (physicalN == 32) {
            if (vecK == 32) qmrq::SmallBatch2Kernel<32, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallBatch2Kernel<32, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (physicalN == 64) {
            if (vecK == 32) qmrq::SmallBatch2Kernel<64, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallBatch2Kernel<64, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else {
            if (vecK == 32) qmrq::SmallBatch2Kernel<128, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallBatch2Kernel<128, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        }
        return;
    }
    // Non-aligned short-K rows otherwise fall into Cube tiling with a large
    // fixed accumulator hand-off.  The vector kernel can zero-pad K<=64 in
    // UB while keeping exact source-N reads and writes, so cover the whole
    // small rectangular region instead of only K=32/64 constants.
    if (m <= 128 && n <= 128 && sourceK > 16 && sourceK <= 64) {
        const uint32_t smallKBlocks = std::min<uint32_t>(m, availableCoreNum * 2);
        const uint32_t vecK = sourceK <= 32 ? 32 : 64;
        if (n <= 8) {
            if (vecK == 32) qmrq::SmallKernel<8, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallKernel<8, 64><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 16) {
            if (vecK == 32) qmrq::SmallKernel<16, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallKernel<16, 64><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 32) {
            if (vecK == 32) qmrq::SmallKernel<32, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallKernel<32, 64><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 64) {
            if (vecK == 32) qmrq::SmallKernel<64, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallKernel<64, 64><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else {
            if (vecK == 32) qmrq::SmallKernel<128, 32><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallKernel<128, 64><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        }
        return;
    }
    // For small M, two rows per Vector block amortize the common B conversion
    // without the Cube accumulator hand-off.  The kernel was previously only
    // selected for M>=49, leaving tiny K=32 cases with one B load per row.
    if (m <= 48 && (sourceK == 32 || sourceK == 64 || sourceK == 128) &&
        n <= 16) {
        const uint32_t pairBlocks = std::min<uint32_t>((m + 1) / 2,
                                                       availableCoreNum * 2);
        if (sourceK == 32) {
            if (n < 8) qmrq::SmallKernel<8, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else if (n == 8) qmrq::SmallBatch2Kernel<8, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (n < 16) qmrq::SmallKernel<16, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallBatch2Kernel<16, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        } else if (sourceK == 64) {
            if (n < 8) qmrq::SmallKernel<8, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else if (n == 8) qmrq::SmallBatch2Kernel<8, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (n < 16) qmrq::SmallKernel<16, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallBatch2Kernel<16, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        } else {
            if (n < 8) qmrq::SmallKernel<8, 128><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else if (n == 8) qmrq::SmallBatch2Kernel<8, 128><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (n < 16) qmrq::SmallKernel<16, 128><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
            else qmrq::SmallBatch2Kernel<16, 128><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        return;
    }
    // K=128 is the largest exact vector panel.  The specialized batch
    // kernels above cover common aligned N; use a padded physical width for
    // every other N<=128 so non-aligned online shapes do not fall back to
    // Cube just because the tail is not one of the template widths.
    if (m <= 32 && n <= 128 && sourceK == 128 &&
        !(n == 16 || n == 32 || n == 64)) {
        const uint32_t smallKBlocks = std::min<uint32_t>(m, availableCoreNum * 2);
        if (n <= 16) {
            qmrq::SmallKernel<16, 128><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 32) {
            qmrq::SmallKernel<32, 128><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else if (n <= 64) {
            qmrq::SmallKernel<64, 128><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        } else {
            qmrq::SmallKernel<128, 128><<<smallKBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, sourceK, n);
        }
        return;
    }
    if (m <= 16 && n <= 16 && sourceK <= 128 &&
        static_cast<uint64_t>(m) * n * sourceK <= 12288) {
        const uint32_t hugeBlocks = std::min<uint32_t>(m, availableCoreNum > 0 ? availableCoreNum : 1);
        qmrq::HugeKKernel<<<hugeBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m, n, sourceK);
        return;
    }
    const uint32_t smallBlocks = std::min<uint32_t>(m, availableCoreNum * 2);
    // The vector kernel also supports 16-aligned N values whose rounded UB
    // width is 64 or 128. Keeping these common small widths off the Cube
    // path removes its fixed tiling and accumulator hand-off cost.
    if (m <= 128 && (k == 32 || k == 64 || k == 128) &&
        (n == 48 || n == 80 || n == 96)) {
        if (n == 48) {
            if (k == 32) qmrq::SmallKernel<48, 32><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallKernel<48, 64><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallKernel<48, 128><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        } else if (n == 80) {
            if (k == 32) qmrq::SmallKernel<80, 32><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallKernel<80, 64><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallKernel<80, 128><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        } else {
            if (k == 32) qmrq::SmallKernel<96, 32><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallKernel<96, 64><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallKernel<96, 128><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        return;
    }
    if (m >= 97 && m <= 128 && k == 128 && (n == 16 || n == 32 || n == 64)) {
        const uint32_t pairBlocks = std::min<uint32_t>((m + 2) / 3, availableCoreNum * 2);
        if (n == 16) qmrq::SmallK128Batch3Kernel<16><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        else if (n == 32) qmrq::SmallK128Batch3Kernel<32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        else qmrq::SmallK128Batch3Kernel<64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        return;
    }
    if (m >= 49 && m <= 96 && (k == 32 || k == 64 || k == 128) &&
        (n == 16 || n == 32 || n == 64)) {
        const uint32_t pairBlocks = std::min<uint32_t>((m + 1) / 2, availableCoreNum * 2);
        if (n == 16) {
            if (k == 32) qmrq::SmallBatch2Kernel<16, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallBatch2Kernel<16, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallBatch2Kernel<16, 128><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        else if (n == 32) {
            if (k == 32) qmrq::SmallBatch2Kernel<32, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallBatch2Kernel<32, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallBatch2Kernel<32, 128><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        else if (n == 64) {
            if (k == 32) qmrq::SmallBatch2Kernel<64, 32><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallBatch2Kernel<64, 64><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallBatch2Kernel<64, 128><<<pairBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        return;
    }
    if (m <= 128 && (k == 32 || k == 64 || k == 128) && (n == 16 || n == 32 || n == 64 || n == 128)) {
        if (n == 16) {
            if (k == 32) qmrq::SmallKernel<16, 32><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallKernel<16, 64><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallKernel<16, 128><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        else if (n == 32) {
            if (k == 32) qmrq::SmallKernel<32, 32><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallKernel<32, 64><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallKernel<32, 128><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        else if (n == 64) {
            if (k == 32) qmrq::SmallKernel<64, 32><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallKernel<64, 64><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallKernel<64, 128><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        else if (n == 128) {
            if (k == 32) qmrq::SmallKernel<128, 32><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else if (k == 64) qmrq::SmallKernel<128, 64><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
            else qmrq::SmallKernel<128, 128><<<smallBlocks, nullptr, stream>>>(x1, x2, x1Scale, x2Scale, y, yScale, m);
        }
        return;
    }
    const uint32_t stride = (n + 15) / 16 * 16;
    uint32_t tileM = std::min<uint32_t>(96,
        (m + availableCoreNum - 1) / availableCoreNum);
    // The Cube/AIV accumulator slots are row tiles.  A sub-8 tile leaves
    // the ND-to-fractal row tail underfilled and can corrupt the adjacent
    // slot for non-aligned M.  Keep a small, shape-independent minimum.
    if (tileM < 8) tileM = 8;
    const bool broadTile = padK && k <= 128 && tileM <= 32 &&
        (m + tileM - 1) / tileM >= availableCoreNum;
    const bool largerColumnTile = tileM <= 48 && (m + tileM - 1) / tileM == availableCoreNum &&
        n >= 2048 && n <= 4096 && n % 2048 == 0 && k >= 512;
    const uint32_t baseN = std::min<uint32_t>(broadTile ? 1024 : (padK ? 256 : (largerColumnTile ? 256 : 128)),
                                             (n + 15) / 16 * 16);
    // Wide tasks span several baseN tiles in one Matmul invocation, keeping
    // the original internal Cube split and avoiding an End at each base tile.
    uint32_t tileN = baseN;
    const bool wide = (m + tileM - 1) / tileM < availableCoreNum && n > baseN;
    if (wide) {
        const uint32_t wideRows = (m + 31) / 32;
        tileM = (m + wideRows - 1) / wideRows;
        const uint32_t wideRowTiles = (m + tileM - 1) / tileM;
        const uint32_t nPartitions = (availableCoreNum + wideRowTiles - 1) / wideRowTiles;
        const uint32_t columnsPerPartition = (n + nPartitions - 1) / nPartitions;
        // A short final row block benefits from distributing the individual
        // base-N tiles across cores instead of assigning a long column span.
        if (m <= 32 || m % 32 == 0) {
            tileN = (columnsPerPartition + baseN - 1) / baseN * baseN;
            // When a row tile would otherwise create one Cube task per
            // column partition, merge adjacent partitions.  This reduces
            // Matmul Init/End and cross-core barrier overhead on wide, short
            // matrices while retaining at least one task per active core.
            if (tileN < 2 * baseN &&
                (n + tileN - 1) / tileN >= availableCoreNum / 2) {
                tileN *= 2;
            }
        }
    }
    const uint32_t rowTiles = (m + tileM - 1) / tileM;
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    matmul_tiling::MatmulApiTiling tiler(*platform);
    using Pos = matmul_tiling::TPosition;
    using Fmt = matmul_tiling::CubeFormat;
    using DT = matmul_tiling::DataType;
    tiler.SetAType(Pos::GM, Fmt::ND, DT::DT_INT8, false);
    tiler.SetBType(Pos::GM, Fmt::ND, DT::DT_INT8, true);
    tiler.SetCType(Pos::GM, Fmt::ND, DT::DT_INT32);
    tiler.SetShape(std::min(m, tileM), wide ? std::min(n, tileN) : n, k);
    tiler.SetOrgShape(m, n, k);
    tiler.SetBias(false);
    tiler.SetFixSplit((tileM + 15) / 16 * 16, baseN,
                     std::min<uint32_t>((padK && baseN >= 512) ? 64 : 128, (k + 31) / 32 * 32));
    tiler.SetBufferSpace(-1, -1, -1);
    const bool useMdl = wide || n > 256 || k > 64;
    tiler.SetMatmulConfigParams(useMdl ? 1 : 0, false);
    AscendC::tiling::TCubeTiling tiling;
    if (tiler.GetTiling(tiling) != 0) {
        return;
    }
    // Alternate two C tiles so the next Cube iteration can overlap Fixpipe.
    // Small C tiles retain the tiler's choice; two large tiles must fit L0C.
    if (!wide && rowTiles <= availableCoreNum && n >= 1024 && n <= 4096 && n % 1024 == 0 && k >= 512) {
        const uint32_t cBytes = tiling.baseM * tiling.baseN * 4;
        if (cBytes >= 32 * 1024 && cBytes <= 64 * 1024) {
            tiling.dbL0C = 2;
            tiling.shareL0CSize = cBytes * 2;
        }
    }
    // The A panel already spans K. Increase the double-buffered B burst
    // while preserving the K-loop divisibility and the 512 KiB L1 limit.
    if (!wide && rowTiles <= availableCoreNum && n >= 1024 && n <= 4096 && n % 1024 == 0 && k >= 512 &&
        tiling.stepM == 1 && tiling.stepN == 1 &&
        tiling.stepKa * tiling.baseK >= k &&
        tiling.depthB1 == tiling.stepKb * 2 &&
        tiling.stepKa % (tiling.stepKb * 2) == 0) {
        const uint64_t aBytes = uint64_t(tiling.baseM) * tiling.baseK * tiling.depthA1;
        const uint64_t bBytes = uint64_t(tiling.baseN) * tiling.baseK * tiling.depthB1 * 2;
        if (aBytes >= 256 * 1024 && aBytes + bBytes <= 512 * 1024) {
            tiling.stepKb *= 2;
            tiling.depthB1 *= 2;
            tiling.shareL1Size = aBytes + bBytes;
        }
    }
    const uint32_t tasks = wide ? rowTiles * ((n + tileN - 1) / tileN) : rowTiles;
    const uint32_t blocks = std::min<uint32_t>(availableCoreNum, tasks);
    const uint64_t workRows = wide ? m : blocks * 2 * tileM;
    const uint64_t accumBytes = workRows * stride * 4;
    const uint64_t padBytes = padK ? ((uint64_t)m + n) * k : 0;
    void* accum = nullptr;
    if (aclrtMalloc(&accum, accumBytes + padBytes,
                    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return;
    }
    if (padK) {
        GM_ADDR paddedA = (GM_ADDR)accum + accumBytes;
        GM_ADDR paddedB = paddedA + (uint64_t)m * k;
        qmrq::PadInputsKernel<<<availableCoreNum * 2, nullptr, stream>>>(
            x1, x2, paddedA, paddedB, m, n, sourceK, k);
        x1 = paddedA; x2 = paddedB;
    }
    if (broadTile && !wide && rowTiles <= availableCoreNum &&
        m >= 256 && n > 15872 && n <= 16448 &&
        tiling.baseM >= tileM && tiling.baseN == 1024 && tiling.stepM == 1 && tiling.stepN == 1) {
        qmrq::LongColumnStreamKernel<<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)accum,
            x1Scale, x2Scale, y, yScale, tiling, m, n, k, stride, tileM, tileN, blocks);
    } else if (!wide && rowTiles <= availableCoreNum && n >= 1024 && n <= 8192 && k >= 512) {
        qmrq::ColumnStreamKernel<<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)accum,
            x1Scale, x2Scale, y, yScale, tiling, m, n, k, stride, tileM, tileN, blocks);
    } else if (wide && n > qmrq::kChunk) {
        qmrq::WideKernel<true><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)accum,
            x1Scale, x2Scale, y, yScale, tiling, m, n, k, stride, tileM, tileN, blocks);
    } else if (wide) {
        qmrq::WideKernel<false><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)accum,
            x1Scale, x2Scale, y, yScale, tiling, m, n, k, stride, tileM, tileN, blocks);
    } else if (n > qmrq::kChunk) {
        qmrq::FusedKernel<CFG_MDL, true><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)accum,
            x1Scale, x2Scale, y, yScale, tiling, m, n, k, stride, tileM, tileN, blocks);
    } else if (useMdl) {
        qmrq::FusedKernel<CFG_MDL><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)accum,
            x1Scale, x2Scale, y, yScale, tiling, m, n, k, stride, tileM, tileN, blocks);
    } else {
        qmrq::FusedKernel<CFG_NORM><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)accum,
            x1Scale, x2Scale, y, yScale, tiling, m, n, k, stride, tileM, tileN, blocks);
    }
    aclrtSynchronizeStream(stream);
    aclrtFree(accum);
}
