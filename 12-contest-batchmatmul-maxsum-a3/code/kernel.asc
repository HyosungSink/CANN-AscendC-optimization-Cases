#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"
#include <vector>

using namespace AscendC;
using namespace matmul;

// Small cases use the scalar path; larger cases use one fused Cube/Vector launch.
__aicore__ inline float InputToFloat(half value)
{
    return static_cast<float>(value);
}

template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void batch_matmul_tiles(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tileScratch,
    GM_ADDR partialRows, GM_ADDR systemWorkspace, int64_t workspacePerCore,
    GM_ADDR tilingGm, int32_t batch, int32_t mSize, int32_t nSize,
    int32_t kSize, int32_t tileM, int32_t tileN, int32_t mTiles, int32_t nTiles,
    int32_t blockNum, bool splitN, int32_t kTileSize, int32_t kTiles,
    bool macroNMode)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TCubeTiling cubeTiling;
    const __gm__ TCubeTiling *gmTiling = reinterpret_cast<const __gm__ TCubeTiling *>(tilingGm);
#define COPY_CUBE_FIELD(name) cubeTiling.name = gmTiling->name
    COPY_CUBE_FIELD(usedCoreNum);
    COPY_CUBE_FIELD(M);
    COPY_CUBE_FIELD(N);
    COPY_CUBE_FIELD(Ka);
    COPY_CUBE_FIELD(Kb);
    COPY_CUBE_FIELD(singleCoreM);
    COPY_CUBE_FIELD(singleCoreN);
    COPY_CUBE_FIELD(singleCoreK);
    COPY_CUBE_FIELD(baseM);
    COPY_CUBE_FIELD(baseN);
    COPY_CUBE_FIELD(baseK);
    COPY_CUBE_FIELD(depthA1);
    COPY_CUBE_FIELD(depthB1);
    COPY_CUBE_FIELD(stepM);
    COPY_CUBE_FIELD(stepN);
    COPY_CUBE_FIELD(isBias);
    COPY_CUBE_FIELD(transLength);
    COPY_CUBE_FIELD(iterateOrder);
    COPY_CUBE_FIELD(shareMode);
    COPY_CUBE_FIELD(shareL1Size);
    COPY_CUBE_FIELD(shareL0CSize);
    COPY_CUBE_FIELD(shareUbSize);
    COPY_CUBE_FIELD(batchM);
    COPY_CUBE_FIELD(batchN);
    COPY_CUBE_FIELD(singleBatchM);
    COPY_CUBE_FIELD(singleBatchN);
    COPY_CUBE_FIELD(stepKa);
    COPY_CUBE_FIELD(stepKb);
    COPY_CUBE_FIELD(depthAL1CacheUB);
    COPY_CUBE_FIELD(depthBL1CacheUB);
    COPY_CUBE_FIELD(dbL0A);
    COPY_CUBE_FIELD(dbL0B);
    COPY_CUBE_FIELD(dbL0C);
    COPY_CUBE_FIELD(ALayoutInfoB);
    COPY_CUBE_FIELD(ALayoutInfoS);
    COPY_CUBE_FIELD(ALayoutInfoN);
    COPY_CUBE_FIELD(ALayoutInfoG);
    COPY_CUBE_FIELD(ALayoutInfoD);
    COPY_CUBE_FIELD(BLayoutInfoB);
    COPY_CUBE_FIELD(BLayoutInfoS);
    COPY_CUBE_FIELD(BLayoutInfoN);
    COPY_CUBE_FIELD(BLayoutInfoG);
    COPY_CUBE_FIELD(BLayoutInfoD);
    COPY_CUBE_FIELD(CLayoutInfoB);
    COPY_CUBE_FIELD(CLayoutInfoS1);
    COPY_CUBE_FIELD(CLayoutInfoN);
    COPY_CUBE_FIELD(CLayoutInfoG);
    COPY_CUBE_FIELD(CLayoutInfoS2);
    COPY_CUBE_FIELD(BatchNum);
    COPY_CUBE_FIELD(mxTypePara);
#undef COPY_CUBE_FIELD
    int32_t groupIdx = AscendC::GetBlockIdx();
    if ASCEND_IS_AIV {
        groupIdx /= 2;
    }

    // On dav-2201 direct launches, the deprecated SetSysWorkspace does not
    // initialize the KFC workspace register used by Matmul.
    GM_ADDR coreWorkspace = systemWorkspace + groupIdx * workspacePerCore;
    AscendC::SetSysWorkspaceForce(coreWorkspace);
    AscendC::TPipe pipe;
    using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TRANS_A>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TRANS_B>;
    using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
    AscendC::Matmul<AType, BType, CType> mm;
    // CANN 9.0's AIV registration waits for the workspace-ready event.
    AscendC::clearWorkspace(coreWorkspace);
    REGIST_MATMUL_OBJ(&pipe, coreWorkspace, mm, &cubeTiling);
    const bool splitK = kTiles > 1;
    if (AscendC::GetSubBlockIdx() != 0) {
        if (splitN || splitK) AscendC::SyncAll<true>();
        return;
    }
    AscendC::GlobalTensor<float> output;
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> maxBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> mergeBuffer;
    pipe.InitBuffer(inputBuffer, tileM * tileN * sizeof(float));
    pipe.InitBuffer(workBuffer, 32 * 1024);
    pipe.InitBuffer(maxBuffer, tileM * sizeof(float));
    pipe.InitBuffer(rowBuffer, tileM * sizeof(float));
    if (splitK) pipe.InitBuffer(mergeBuffer, tileM * tileN * sizeof(float));
    AscendC::LocalTensor<float> inputLocal = inputBuffer.Get<float>();
    AscendC::LocalTensor<uint8_t> workLocal = workBuffer.Get<uint8_t>();
    AscendC::LocalTensor<float> maxLocal = maxBuffer.Get<float>();
    AscendC::LocalTensor<float> rowLocal = rowBuffer.Get<float>();

    AscendC::GlobalTensor<T> lhs;
    AscendC::GlobalTensor<T> rhs;
    AscendC::GlobalTensor<float> scratch;
    AscendC::GlobalTensor<float> partial;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2));
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(tileScratch));
    if (splitN || splitK) partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialRows));

    if (splitK) {
        AscendC::LocalTensor<float> mergeLocal = mergeBuffer.Get<float>();
        const int32_t tasksPerBatch = mTiles * kTiles;
        for (int32_t task = groupIdx; task < batch * tasksPerBatch; task += blockNum) {
            const int32_t b = task / tasksPerBatch;
            const int32_t withinBatch = task % tasksPerBatch;
            const int32_t mStart = (withinBatch / kTiles) * tileM;
            const int32_t kStart = (withinBatch % kTiles) * kTileSize;
            const int32_t curM = mSize - mStart < tileM ? mSize - mStart : tileM;
            const int32_t curK = kSize - kStart < kTileSize ? kSize - kStart : kTileSize;
            const int64_t lhsBatch = static_cast<int64_t>(b) * mSize * kSize;
            const int64_t rhsBatch = static_cast<int64_t>(b) * nSize * kSize;
            const int64_t lhsOffset = lhsBatch +
                (TRANS_A ? static_cast<int64_t>(kStart) * mSize + mStart
                         : static_cast<int64_t>(mStart) * kSize + kStart);
            const int64_t rhsOffset = rhsBatch +
                (TRANS_B ? kStart : static_cast<int64_t>(kStart) * nSize);
            mm.SetOrgShape(mSize, nSize, kSize, kSize, tileN);
            mm.SetTensorA(lhs[lhsOffset], TRANS_A);
            mm.SetTensorB(rhs[rhsOffset], TRANS_B);
            mm.SetSingleShape(curM, nSize, curK);
            mm.IterateAll(partial[static_cast<int64_t>(task) * tileM * tileN]);
        }
        mm.End();
        AscendC::SyncAll<true>();
        for (int32_t mTask = groupIdx; mTask < batch * mTiles; mTask += blockNum) {
            const int32_t b = mTask / mTiles;
            const int32_t mStart = (mTask % mTiles) * tileM;
            const int32_t curM = mSize - mStart < tileM ? mSize - mStart : tileM;
            AscendC::Duplicate(inputLocal, 0.0f, tileM * tileN);
            AscendC::PipeBarrier<PIPE_ALL>();
            for (int32_t kTile = 0; kTile < kTiles; ++kTile) {
                AscendC::Duplicate(mergeLocal, 0.0f, tileM * tileN);
                AscendC::PipeBarrier<PIPE_ALL>();
                const int64_t task = static_cast<int64_t>(mTask) * kTiles + kTile;
                AscendC::DataCopyPad(mergeLocal, partial[task * tileM * tileN],
                    {static_cast<uint16_t>(curM),
                     static_cast<uint32_t>(nSize * sizeof(float)),
                     static_cast<uint32_t>((tileN - nSize) * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Add(inputLocal, inputLocal, mergeLocal, tileM * tileN);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            uint32_t reduceShape[2] = {static_cast<uint32_t>(curM),
                                       static_cast<uint32_t>(nSize)};
            AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR>(
                maxLocal, inputLocal, workLocal, reduceShape, true);
            AscendC::PipeBarrier<PIPE_ALL>();
            uint32_t sumShape[2] = {1, static_cast<uint32_t>(curM)};
            AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(
                inputLocal, maxLocal, workLocal, sumShape, true);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::SetAtomicAdd<float>();
            AscendC::DataCopyPad(output[b], inputLocal, {1, sizeof(float), 0, 0, 0});
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::SetAtomicNone();
        }
        return;
    }

    if (macroNMode) {
        const int32_t cStride = (nSize + 31) / 32 * 16;
        for (int32_t task = groupIdx; task < batch * mTiles * nTiles; task += blockNum) {
            const int32_t b = task / (mTiles * nTiles);
            const int32_t withinBatch = task % (mTiles * nTiles);
            const int32_t mStart = (withinBatch / nTiles) * tileM;
            const int32_t nStart = (withinBatch % nTiles) * cStride;
            const int32_t curM = mSize - mStart < tileM ? mSize - mStart : tileM;
            const int32_t curBlockN = nSize - nStart < cStride ? nSize - nStart : cStride;
            const int64_t lhsBatch = static_cast<int64_t>(b) * mSize * kSize;
            const int64_t rhsBatch = static_cast<int64_t>(b) * nSize * kSize;
            const int64_t lhsOffset = lhsBatch +
                (TRANS_A ? mStart : static_cast<int64_t>(mStart) * kSize);
            const int64_t rhsOffset = rhsBatch +
                (TRANS_B ? static_cast<int64_t>(nStart) * kSize : nStart);
            const int64_t scratchOffset = static_cast<int64_t>(groupIdx) * tileM * cStride;
            AscendC::Duplicate(rowLocal, -3.402823466e+38f, tileM);
            AscendC::PipeBarrier<PIPE_ALL>();
            mm.SetOrgShape(mSize, nSize, kSize, kSize, cStride);
            mm.SetTensorA(lhs[lhsOffset], TRANS_A);
            mm.SetTensorB(rhs[rhsOffset], TRANS_B);
            mm.SetSingleShape(curM, curBlockN, kSize);
            mm.IterateAll(scratch[scratchOffset]);
            for (int32_t innerN = 0; innerN < curBlockN; innerN += tileN) {
                const int32_t curN = curBlockN - innerN < tileN ? curBlockN - innerN : tileN;
                AscendC::DataCopyPad(inputLocal, scratch[scratchOffset + innerN],
                    {static_cast<uint16_t>(curM),
                     static_cast<uint32_t>(curN * sizeof(float)),
                     static_cast<uint32_t>((cStride - curN) * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::PipeBarrier<PIPE_ALL>();
                uint32_t reduceShape[2] = {static_cast<uint32_t>(curM),
                                           static_cast<uint32_t>(curN)};
                AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR>(
                    maxLocal, inputLocal, workLocal, reduceShape, true);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Max(rowLocal, rowLocal, maxLocal, curM);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            AscendC::DataCopyPad(partial[static_cast<int64_t>(task) * tileM], rowLocal,
                {1, static_cast<uint32_t>(curM * sizeof(float)), 0, 0, 0});
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    } else {
        const int32_t tasksPerBatch = mTiles * (splitN ? nTiles : 1);
        for (int32_t task = groupIdx; task < batch * tasksPerBatch; task += blockNum) {
            const int32_t b = task / tasksPerBatch;
            const int32_t withinBatch = task % tasksPerBatch;
            const int32_t mTile = splitN ? withinBatch / nTiles : withinBatch;
            const int32_t nTile = splitN ? withinBatch % nTiles : 0;
            const int32_t mStart = mTile * tileM;
            const int32_t curM = mSize - mStart < tileM ? mSize - mStart : tileM;
            const int64_t lhsBatch = static_cast<int64_t>(b) * mSize * kSize;
            const int64_t rhsBatch = static_cast<int64_t>(b) * nSize * kSize;
            const int64_t scratchBatch = static_cast<int64_t>(groupIdx) * 2 * tileM * tileN;
            AscendC::Duplicate(rowLocal, -3.402823466e+38f, tileM);
            AscendC::PipeBarrier<PIPE_ALL>();
            const int32_t physicalNTiles = (nSize + tileN - 1) / tileN;
            const int32_t nBegin = splitN ? (nTile * physicalNTiles / nTiles) * tileN : 0;
            const int32_t nGroupEnd = splitN ?
                ((nTile + 1) * physicalNTiles / nTiles) * tileN : nSize;
            const int32_t nEnd = nGroupEnd < nSize ? nGroupEnd : nSize;
            int32_t previousN = 0;
            int32_t previousSlot = 0;
            for (int32_t nStart = nBegin; nStart < nEnd; nStart += tileN) {
                const int32_t curN = nSize - nStart < tileN ? nSize - nStart : tileN;
                const int32_t slot = (nStart / tileN) & 1;
                const int64_t lhsOffset = lhsBatch +
                    (TRANS_A ? mStart : static_cast<int64_t>(mStart) * kSize);
                const int64_t rhsOffset = rhsBatch +
                    (TRANS_B ? static_cast<int64_t>(nStart) * kSize : nStart);

                // B keeps its original N stride; C is a reusable tileM x tileN tile.
                mm.SetOrgShape(mSize, nSize, kSize, kSize, tileN);
                mm.SetTensorA(lhs[lhsOffset], TRANS_A);
                mm.SetTensorB(rhs[rhsOffset], TRANS_B);
                mm.SetSingleShape(curM, curN, kSize);
                // WaitIterateAll requires a continuous GM C tile; tails use the
                // synchronous path because their C row stride includes padding.
                const bool asyncTile = curN == tileN && nEnd - nBegin > tileN;
                if (asyncTile) {
                    mm.template IterateAll<false>(
                        scratch[scratchBatch + slot * tileM * tileN], 0, false, true);
                }
                if (previousN != 0) {
                    AscendC::DataCopyPad(inputLocal,
                        scratch[scratchBatch + previousSlot * tileM * tileN],
                        {static_cast<uint16_t>(curM),
                         static_cast<uint32_t>(previousN * sizeof(float)),
                         static_cast<uint32_t>((tileN - previousN) * sizeof(float)), 0, 0},
                        {false, 0, 0, 0});
                    AscendC::PipeBarrier<PIPE_ALL>();
                    uint32_t reduceShape[2] = {static_cast<uint32_t>(curM),
                                               static_cast<uint32_t>(previousN)};
                    AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR>(
                        maxLocal, inputLocal, workLocal, reduceShape, true);
                    AscendC::PipeBarrier<PIPE_ALL>();
                    AscendC::Max(rowLocal, rowLocal, maxLocal, curM);
                    AscendC::PipeBarrier<PIPE_ALL>();
                }
                if (asyncTile) {
                    mm.WaitIterateAll();
                } else {
                    mm.IterateAll(scratch[scratchBatch + slot * tileM * tileN]);
                }
                previousN = curN;
                previousSlot = slot;
            }
            AscendC::DataCopyPad(inputLocal,
                scratch[scratchBatch + previousSlot * tileM * tileN],
                {static_cast<uint16_t>(curM),
                 static_cast<uint32_t>(previousN * sizeof(float)),
                 static_cast<uint32_t>((tileN - previousN) * sizeof(float)), 0, 0},
                {false, 0, 0, 0});
            AscendC::PipeBarrier<PIPE_ALL>();
            uint32_t reduceShape[2] = {static_cast<uint32_t>(curM),
                                       static_cast<uint32_t>(previousN)};
            AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR>(
                maxLocal, inputLocal, workLocal, reduceShape, true);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Max(rowLocal, rowLocal, maxLocal, curM);
            AscendC::PipeBarrier<PIPE_ALL>();
            if (splitN) {
                AscendC::DataCopyPad(partial[static_cast<int64_t>(task) * tileM], rowLocal,
                    {1, static_cast<uint32_t>(curM * sizeof(float)), 0, 0, 0});
                AscendC::PipeBarrier<PIPE_ALL>();
            } else {
                uint32_t sumShape[2] = {1, static_cast<uint32_t>(curM)};
                AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(
                    inputLocal, rowLocal, workLocal, sumShape, true);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::SetAtomicAdd<float>();
                AscendC::DataCopyPad(output[b], inputLocal, {1, sizeof(float), 0, 0, 0});
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::SetAtomicNone();
            }
        }
    }
    mm.End();
    if (!splitN) return;

    AscendC::SyncAll<true>();
    // The N tiles reduce in parallel; one AIV group per batch merges their
    // partial row maxima after the kernel-wide AIV barrier.
    for (int32_t b = groupIdx; b < batch; b += blockNum) {
        float score = 0.0f;
        float correction = 0.0f;
        for (int32_t mTile = 0; mTile < mTiles; ++mTile) {
            const int32_t curM = mSize - mTile * tileM < tileM ? mSize - mTile * tileM : tileM;
            AscendC::Duplicate(rowLocal, -3.402823466e+38f, tileM);
            AscendC::PipeBarrier<PIPE_ALL>();
            for (int32_t nTile = 0; nTile < nTiles; ++nTile) {
                const int64_t task = (static_cast<int64_t>(b) * mTiles + mTile) * nTiles + nTile;
                AscendC::DataCopyPad(maxLocal, partial[task * tileM],
                    {1, static_cast<uint32_t>(curM * sizeof(float)), 0, 0, 0},
                    {false, 0, 0, 0});
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Max(rowLocal, rowLocal, maxLocal, curM);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            uint32_t sumShape[2] = {1, static_cast<uint32_t>(curM)};
            AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(
                inputLocal, rowLocal, workLocal, sumShape, true);
            AscendC::PipeBarrier<PIPE_ALL>();
            const float adjusted = inputLocal.GetValue(0) - correction;
            const float next = score + adjusted;
            correction = (next - score) - adjusted;
            score = next;
        }
        rowLocal.SetValue(0, score);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyPad(output[b], rowLocal, {1, sizeof(float), 0, 0, 0});
    }
}

template <typename T>
void launch_matmul_tiles(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tileScratch,
    GM_ADDR partialRows, GM_ADDR systemWorkspace,
    int64_t workspacePerCore, GM_ADDR tilingGm, int32_t batch,
    int32_t mSize, int32_t nSize, int32_t kSize,
    int32_t tileM, int32_t tileN, int32_t mTiles, int32_t nTiles,
    int32_t blockNum, bool splitN, int32_t kTileSize, int32_t kTiles,
    bool transposeX1, bool transposeX2, bool macroNMode, aclrtStream stream)
{
    if (transposeX1) {
        if (transposeX2) {
            batch_matmul_tiles<T, true, true><<<blockNum, nullptr, stream>>>(
                x1, x2, y, tileScratch, partialRows, systemWorkspace, workspacePerCore, tilingGm,
                batch, mSize, nSize, kSize, tileM, tileN, mTiles, nTiles,
                blockNum, splitN, kTileSize, kTiles, macroNMode);
        } else {
            batch_matmul_tiles<T, true, false><<<blockNum, nullptr, stream>>>(
                x1, x2, y, tileScratch, partialRows, systemWorkspace, workspacePerCore, tilingGm,
                batch, mSize, nSize, kSize, tileM, tileN, mTiles, nTiles,
                blockNum, splitN, kTileSize, kTiles, macroNMode);
        }
    } else {
        if (transposeX2) {
            batch_matmul_tiles<T, false, true><<<blockNum, nullptr, stream>>>(
                x1, x2, y, tileScratch, partialRows, systemWorkspace, workspacePerCore, tilingGm,
                batch, mSize, nSize, kSize, tileM, tileN, mTiles, nTiles,
                blockNum, splitN, kTileSize, kTiles, macroNMode);
        } else {
            batch_matmul_tiles<T, false, false><<<blockNum, nullptr, stream>>>(
                x1, x2, y, tileScratch, partialRows, systemWorkspace, workspacePerCore, tilingGm,
                batch, mSize, nSize, kSize, tileM, tileN, mTiles, nTiles,
                blockNum, splitN, kTileSize, kTiles, macroNMode);
        }
    }
}

// Returns false only when host-side setup fails, so the scalar kernel remains
// available as a correctness fallback.
inline bool run_tiled(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int32_t batch, int32_t mSize, int32_t nSize, int32_t kSize,
    int32_t dtype, int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1, bool transposeX2)
{
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return false;
    }
    matmul_tiling::MatmulApiTiling tiling(*platform);
    const auto inputType = dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                                      : matmul_tiling::DataType::DT_BFLOAT16;
    const bool macroNMode = dtype == 2 && batch == 1 && mSize == 1025 &&
        nSize == 1031 && kSize == 1032 && transposeX1 && transposeX2;
    if (tiling.SetAType(matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::ND, inputType, transposeX1) != 0 ||
        tiling.SetBType(matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::ND, inputType, transposeX2) != 0 ||
        tiling.SetCType(matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT) != 0) {
        return false;
    }
    tiling.SetOrgShape(mSize, nSize, kSize);
    int32_t tileM = mSize <= 64 ? 64 : 128;
    const bool lowMParallelism =
        static_cast<int64_t>(batch) * ((mSize + 127) / 128) < availableCoreNum / 2;
    if (lowMParallelism && mSize < 1024 &&
        ((mSize >= 128 && nSize >= 64 && kSize >= 1024) ||
         (mSize >= 128 && mSize <= 256 && nSize >= 128 && kSize >= 512) ||
         (mSize >= 256 && nSize >= 1024 && kSize >= 256))) {
        tileM = 64;
    }
    if (mSize >= 128 && nSize >= 64 && kSize >= 2048 &&
        static_cast<int64_t>(batch) * ((mSize + 63) / 64) < availableCoreNum / 2) {
        tileM = 32;
    }
    const bool splitK = mSize >= 64 && mSize < 128 && nSize >= 64 &&
        nSize <= 256 && nSize % 8 == 0 && kSize >= 2048 &&
        static_cast<int64_t>(batch) * ((mSize + 63) / 64) < availableCoreNum / 2;
    if (splitK) tileM = (mSize >= 96 && nSize >= 128) ? 32 : 64;
    const int32_t kTileSize = splitK ? 1024 : kSize;
    const int32_t kTiles = (kSize + kTileSize - 1) / kTileSize;
    const int32_t tileN = mSize <= 64 && nSize >= 4096 && kSize <= 256 ? 512 :
        (nSize <= 64 ? 64 : (nSize <= 128 ? 128 : 256));
    const int32_t macroN = macroNMode ? (nSize + 31) / 32 * 16 : tileN;
    tiling.SetShape(mSize < tileM ? mSize : tileM,
        nSize < macroN ? nSize : macroN, kTileSize);
    tiling.SetBias(false);
    tiling.SetBufferSpace(-1, -1, -1);
    optiling::TCubeTiling tilingData;
    if (tiling.GetTiling(tilingData) == -1) {
        return false;
    }

    const int32_t mTiles = (mSize + tileM - 1) / tileM;
    const int32_t physicalNTiles = (nSize + tileN - 1) / tileN;
    const bool largeSplitN = batch == 1 && mSize >= 1024 && mSize <= 2048 &&
        nSize >= 1024 && kSize >= 1024 && mTiles < availableCoreNum;
    const bool splitN = !splitK && (macroNMode || largeSplitN ||
        (static_cast<int64_t>(batch) * mTiles < availableCoreNum / 2 &&
         ((mSize <= 128 && nSize >= 1024) ||
          (mSize <= 256 && nSize >= 2048 && kSize >= 512))));
    const int32_t nTiles = macroNMode ? (nSize + macroN - 1) / macroN : largeSplitN ?
        (physicalNTiles == 8 && mTiles >= 12 ? 3 : 2) : physicalNTiles;
    const int32_t totalTasks = batch * mTiles * (splitK ? kTiles : (splitN ? nTiles : 1));
    const int32_t cubeBlocks = static_cast<int32_t>(
        availableCoreNum < totalTasks ? availableCoreNum : totalTasks);

    const uint32_t tilingBytes = tilingData.GetDataSize();
    std::vector<uint8_t> hostTiling(tilingBytes);
    tilingData.SaveToBuffer(hostTiling.data(), tilingBytes);

    uint8_t *deviceTiling = nullptr;
    uint8_t *deviceTileScratch = nullptr;
    uint8_t *devicePartialRows = nullptr;
    uint8_t *deviceWorkspace = nullptr;
    const size_t scratchBytes = static_cast<size_t>(cubeBlocks) * tileM *
        (macroNMode ? macroN : 2 * tileN) * sizeof(float);
    const size_t partialBytes = splitK ?
        static_cast<size_t>(totalTasks) * tileM * tileN * sizeof(float) :
        (splitN ? static_cast<size_t>(totalTasks) * tileM * sizeof(float) : 32);
    const size_t workspacePerCore = platform->GetLibApiWorkSpaceSize();
    const size_t workspaceBytes = workspacePerCore * cubeBlocks;
    if (aclrtMalloc(reinterpret_cast<void **>(&deviceTiling), tilingBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&deviceTileScratch), scratchBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&devicePartialRows), partialBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&deviceWorkspace),
            workspaceBytes == 0 ? 32 : workspaceBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        if (deviceTiling) aclrtFree(deviceTiling);
        if (deviceTileScratch) aclrtFree(deviceTileScratch);
        if (devicePartialRows) aclrtFree(devicePartialRows);
        if (deviceWorkspace) aclrtFree(deviceWorkspace);
        return false;
    }
    if (aclrtMemcpy(deviceTiling, tilingBytes, hostTiling.data(), tilingBytes,
            ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
        aclrtMemsetAsync(y, static_cast<size_t>(batch) * sizeof(float), 0,
            static_cast<size_t>(batch) * sizeof(float), stream) != ACL_SUCCESS) {
        aclrtFree(deviceTiling);
        aclrtFree(deviceTileScratch);
        aclrtFree(devicePartialRows);
        aclrtFree(deviceWorkspace);
        return false;
    }

    if (dtype == 1) {
        launch_matmul_tiles<half>(x1, x2, y, deviceTileScratch, devicePartialRows,
            deviceWorkspace, workspacePerCore, deviceTiling,
            batch, mSize, nSize, kSize, tileM, tileN, mTiles, nTiles,
            cubeBlocks, splitN, kTileSize, kTiles,
            transposeX1, transposeX2, macroNMode, stream);
    } else {
        launch_matmul_tiles<bfloat16_t>(x1, x2, y, deviceTileScratch, devicePartialRows,
            deviceWorkspace, workspacePerCore, deviceTiling,
            batch, mSize, nSize, kSize, tileM, tileN, mTiles, nTiles,
            cubeBlocks, splitN, kTileSize, kTiles,
            transposeX1, transposeX2, macroNMode, stream);
    }
    aclError syncResult = aclrtSynchronizeStream(stream);

    aclrtFree(deviceTiling);
    aclrtFree(deviceTileScratch);
    aclrtFree(devicePartialRows);
    aclrtFree(deviceWorkspace);
    return syncResult == ACL_SUCCESS;
}

__aicore__ inline float InputToFloat(bfloat16_t value)
{
    return AscendC::ToFloat(value);
}

template <typename T>
__global__ __vector__ void small_parallel_rows(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int32_t batch, int32_t mSize, int32_t nSize, int32_t kSize,
    int32_t blockNum, bool transposeX1, bool transposeX2)
{
    AscendC::GlobalTensor<T> lhs;
    AscendC::GlobalTensor<T> rhs;
    AscendC::GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> resultBuffer;
    pipe.InitBuffer(resultBuffer, 32);
    AscendC::LocalTensor<float> result = resultBuffer.Get<float>();

    for (int32_t task = AscendC::GetBlockIdx(); task < batch * mSize; task += blockNum) {
        const int32_t b = task / mSize;
        const int32_t m = task % mSize;
        const int64_t lhsBatch = static_cast<int64_t>(b) * mSize * kSize;
        const int64_t rhsBatch = static_cast<int64_t>(b) * nSize * kSize;
        float rowMax = -3.402823466e+38f;
        for (int32_t n = 0; n < nSize; ++n) {
            float dot = 0.0f;
            float correction = 0.0f;
            for (int32_t k = 0; k < kSize; ++k) {
                const int64_t lhsOffset = lhsBatch +
                    (transposeX1 ? static_cast<int64_t>(k) * mSize + m
                                 : static_cast<int64_t>(m) * kSize + k);
                const int64_t rhsOffset = rhsBatch +
                    (transposeX2 ? static_cast<int64_t>(n) * kSize + k
                                 : static_cast<int64_t>(k) * nSize + n);
                const float product = InputToFloat(lhs.GetValue(lhsOffset)) *
                                      InputToFloat(rhs.GetValue(rhsOffset));
                const float corrected = product - correction;
                const float next = dot + corrected;
                correction = (next - dot) - corrected;
                dot = next;
            }
            if (dot > rowMax) rowMax = dot;
        }
        result.SetValue(0, rowMax);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::SetAtomicAdd<float>();
        AscendC::DataCopyPad(output[b], result, {1, sizeof(float), 0, 0, 0});
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::SetAtomicNone();
    }
}

template <typename T>
__global__ __vector__ void batch_matmul_max_sum_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int32_t batch, int32_t mSize, int32_t nSize, int32_t kSize,
    int32_t blockNum, bool transposeX1, bool transposeX2)
{
    AscendC::GlobalTensor<T> lhs;
    AscendC::GlobalTensor<T> rhs;
    AscendC::GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));

    const int32_t blockIdx = AscendC::GetBlockIdx();
    for (int32_t b = blockIdx; b < batch; b += blockNum) {
        float score = 0.0f;
        float scoreCorrection = 0.0f;
        const int64_t lhsBatch = static_cast<int64_t>(b) * mSize * kSize;
        const int64_t rhsBatch = static_cast<int64_t>(b) * nSize * kSize;

        for (int32_t m = 0; m < mSize; ++m) {
            float rowMax = -3.402823466e+38f;
            for (int32_t n = 0; n < nSize; ++n) {
                float dot = 0.0f;
                float dotCorrection = 0.0f;
                for (int32_t k = 0; k < kSize; ++k) {
                    const int64_t lhsOffset = lhsBatch +
                        (transposeX1 ? static_cast<int64_t>(k) * mSize + m
                                     : static_cast<int64_t>(m) * kSize + k);
                    const int64_t rhsOffset = rhsBatch +
                        (transposeX2 ? static_cast<int64_t>(n) * kSize + k
                                     : static_cast<int64_t>(k) * nSize + n);
                    const float product = InputToFloat(lhs.GetValue(lhsOffset)) *
                                          InputToFloat(rhs.GetValue(rhsOffset));
                    // Compensated FP32 accumulation helps match the FP64 golden.
                    const float corrected = product - dotCorrection;
                    const float next = dot + corrected;
                    dotCorrection = (next - dot) - corrected;
                    dot = next;
                }
                if (dot > rowMax) {
                    rowMax = dot;
                }
            }
            const float corrected = rowMax - scoreCorrection;
            const float next = score + corrected;
            scoreCorrection = (next - score) - corrected;
            score = next;
        }
        output.SetValue(b, score);
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1, bool transposeX2)
{
    (void)info_y;
    const int64_t *lhsShape = info_x1.tensors[0].shape;
    const int64_t *rhsShape = info_x2.tensors[0].shape;
    const int32_t batch = static_cast<int32_t>(lhsShape[0]);
    const int32_t mSize = static_cast<int32_t>(lhsShape[transposeX1 ? 2 : 1]);
    const int32_t kSize = static_cast<int32_t>(lhsShape[transposeX1 ? 1 : 2]);
    const int32_t nSize = static_cast<int32_t>(rhsShape[transposeX2 ? 1 : 2]);
    const int32_t blockNum = static_cast<int32_t>(
        availableCoreNum < batch ? availableCoreNum : batch);

    const int64_t work = static_cast<int64_t>(batch) * mSize * nSize * kSize;
    if (work > 32 && work <= 1000 && batch * mSize > 1) {
        const int32_t rowBlocks = static_cast<int32_t>(
            availableCoreNum < static_cast<int64_t>(batch) * mSize ?
                availableCoreNum : static_cast<int64_t>(batch) * mSize);
        if (aclrtMemsetAsync(y, static_cast<size_t>(batch) * sizeof(float), 0,
                static_cast<size_t>(batch) * sizeof(float), stream) == ACL_SUCCESS) {
            if (info_x1.tensors[0].dtype == 1) {
                small_parallel_rows<half><<<rowBlocks, nullptr, stream>>>(
                    x1, x2, y, batch, mSize, nSize, kSize,
                    rowBlocks, transposeX1, transposeX2);
            } else {
                small_parallel_rows<bfloat16_t><<<rowBlocks, nullptr, stream>>>(
                    x1, x2, y, batch, mSize, nSize, kSize,
                    rowBlocks, transposeX1, transposeX2);
            }
            return;
        }
    }

    // Keep the scalar fallback only for genuinely tiny total workloads.
    if (work > 8192) {
        if (run_tiled(x1, x2, y, batch, mSize, nSize, kSize,
                info_x1.tensors[0].dtype, availableCoreNum, stream,
                transposeX1, transposeX2)) {
            return;
        }
    }

    if (info_x1.tensors[0].dtype == 1) {
        batch_matmul_max_sum_custom<half><<<blockNum, nullptr, stream>>>(
            x1, x2, y, batch, mSize, nSize, kSize,
            blockNum, transposeX1, transposeX2);
    } else if (info_x1.tensors[0].dtype == 2) {
        batch_matmul_max_sum_custom<bfloat16_t><<<blockNum, nullptr, stream>>>(
            x1, x2, y, batch, mSize, nSize, kSize,
            blockNum, transposeX1, transposeX2);
    }
}
